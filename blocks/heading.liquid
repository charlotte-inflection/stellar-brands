{%- if block.settings.heading != blank -%}
  {%- liquid
    assign with_gradient = false
    if section.settings.gradient_highlight != blank and section.settings.gradient_highlight != 'rgba(0,0,0,0)'
      assign with_gradient = true
    endif

    assign alignment = 'inherit'
    if block.settings.width != 'fit-content'
      assign alignment = block.settings.alignment
    endif
    assign alignment_mobile = 'inherit'
    if block.settings.width != 'fit-content'
      assign alignment_mobile = block.settings.alignment_mobile
    endif

    comment
      Process heading content for line break and highlight.
      These are applied to the raw heading text before effects processing.
    endcomment
    assign processed_heading = block.settings.heading

    comment
      Highlight: wrap matching text in a styled span.
      Applied before line break so it works across both lines if needed.
    endcomment
    if block.settings.highlight_text != blank
      assign hl_text = block.settings.highlight_text
      assign hl_weight = block.settings.highlight_weight | default: 'inherit'
      assign hl_color = block.settings.highlight_color | default: 'inherit'
      assign hl_open = '<span class="stellar-heading-highlight" style="--stellar-highlight-weight:' | append: hl_weight | append: ';--stellar-highlight-color:' | append: hl_color | append: ';">'
      assign hl_close = '</span>'
      assign processed_heading = processed_heading | replace: hl_text, hl_open | append: hl_text | append: hl_close
      comment
        The above replace is naive; reconstruct properly.
      endcomment
      assign processed_heading = block.settings.heading | split: hl_text | join: hl_open | append: hl_close
      comment
        Actually, use a simpler split/join approach:
        Split on the highlight text, then rejoin with the styled wrapper.
      endcomment
      assign hl_replacement = hl_open | append: hl_text | append: hl_close
      assign processed_heading = block.settings.heading | replace: hl_text, hl_replacement
    endif

    comment
      Line break: split heading at the specified word boundary.
      Everything after line_break_after text gets wrapped in stellar-heading-line-2.
    endcomment
    if block.settings.line_break_after != blank
      assign break_marker = block.settings.line_break_after
      assign heading_parts = processed_heading | split: break_marker
      if heading_parts.size > 1
        assign line_1 = heading_parts | first | append: break_marker
        assign line_2_parts = heading_parts | slice: 1, heading_parts.size
        assign line_2 = line_2_parts | join: break_marker
        assign processed_heading = line_1 | append: '<span class="stellar-heading-line-2">' | append: line_2 | append: '</span>'
      endif
    endif
  -%}
  <{{ block.settings.heading_tag }} class="heading leading-none {{ block.settings.heading_size }} text-{{ alignment_mobile }} md:text-{{ alignment }} size-style"{% if block.settings.heading_font != blank and block.settings.heading_font != 'default' %} data-heading-font="{{ block.settings.heading_font }}"{% endif %} style="{% render 'section-size-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    {%- if block.settings.effects == 'reveal' -%}
      <split-words class="split-words js-invisible block" data-animate="fade-up-large" data-animate-delay="250">{{ processed_heading }}</split-words>
    {%- elsif block.settings.effects == 'highlight' -%}
      {%- render 'heading-content', content: processed_heading, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, reveal: block.settings.highlighted_reveal, gradient: with_gradient -%}
    {%- else -%}
      {{- processed_heading -}}
    {%- endif -%}
  </{{ block.settings.heading_tag }}>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.heading.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Example heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "title-sm",
          "label": "t:sections.global.settings.heading_size.options__1.label"
        },
        {
          "value": "title-md",
          "label": "t:sections.global.settings.heading_size.options__2.label"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__3.label"
        },
        {
          "value": "title-xl tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__4.label"
        }
      ],
      "default": "title-md",
      "label": "t:sections.global.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.global.settings.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.global.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.global.settings.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.global.settings.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.global.settings.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.global.settings.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.global.settings.heading_tag.options__7.label"
        },
        {
          "value": "span",
          "label": "t:sections.global.settings.heading_tag.options__8.label"
        },
        {
          "value": "p",
          "label": "t:sections.global.settings.heading_tag.options__9.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.global.settings.heading_tag.label",
      "info": "t:sections.global.settings.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_font",
      "options": [
        {
          "value": "default",
          "label": "Default (follows heading tag)"
        },
        {
          "value": "rowdies",
          "label": "Rowdies"
        },
        {
          "value": "grotesk",
          "label": "NN Forever Grotesk"
        }
      ],
      "default": "default",
      "label": "Heading font",
      "info": "Override the font for this heading. Default uses the heading-level rule (H1-H2 = Rowdies, H3+ = NN Forever Grotesk)."
    },
    {
      "type": "header",
      "content": "Split and highlight"
    },
    {
      "type": "text",
      "id": "line_break_after",
      "label": "Line break after",
      "info": "Enter the last word (or words) before the line break. Everything after this text wraps to a second line. Leave blank for no break."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight text",
      "info": "Enter the exact text to highlight. This text will be styled with the weight and color below. Leave blank for no highlight."
    },
    {
      "type": "select",
      "id": "highlight_weight",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "inherit",
      "label": "Highlight font weight"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#655DC6",
      "info": "Color applied to the highlighted text segment."
    },
    {
      "type": "header",
      "content": "t:blocks.group.settings.header__size.content"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "options": [
        {
          "value": "fit-content",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:blocks.group.settings.custom_width.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "default": "left",
      "visible_if": "{{ block.settings.width == 'fill' or block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.group.settings.width_mobile.label",
      "options": [
        {
          "value": "fit-content",
          "label": "t:blocks.group.settings.width.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:blocks.group.settings.width.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.settings.width.options__3.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:blocks.group.settings.custom_width.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_mobile",
      "label": "t:blocks.group.settings.alignment_mobile.label",
      "default": "left",
      "visible_if": "{{ block.settings.width_mobile == 'fill' or block.settings.width_mobile == 'custom' }}"
    },
    {
