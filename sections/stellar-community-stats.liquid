{% comment %}
  Stellar Community Stats
  Animated stat counters with count-up animation.
  @concept-theme: section-type="multicolumn" | block-type="heading,text"
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;border-top:1px solid hsla(0,0%,13%,0.05);border-bottom:1px solid hsla(0,0%,13%,0.05);{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
  id="stellar-stats-{{ section.id }}"
>
  <div class="stellar-container">
    <div style="display:flex;flex-wrap:wrap;gap:2rem;max-width:56rem;margin:0 auto;text-align:center;justify-content:center;">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div style="flex:1;min-width:8rem;" {{ block.shopify_attributes }}>
            <p class="stellar-font-display stellar-countup" data-target="{{ block.settings.value }}" style="font-size:clamp(1.5rem,3vw,3rem);color:var(--stellar-purple);margin-bottom:0.5rem;">
              {{ block.settings.value }}
            </p>
            <p class="stellar-eyebrow" style="color:#fff;">
              {{ block.settings.label }}
            </p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div style="max-width:48rem;margin:2rem auto 0;">
      {% for block in section.blocks %}
        {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
          {% render 'stellar-standard-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function(){
    var section = document.getElementById('stellar-stats-{{ section.id }}');
    if (!section) return;
    var els = section.querySelectorAll('.stellar-countup');
    if (!els.length) return;
    var animated = false;
    function animateCountUp(el) {
      var raw = el.getAttribute('data-target') || '';
      var numMatch = raw.match(/[\d,]+/);
      if (!numMatch) return;
      var target = parseInt(numMatch[0].replace(/,/g, ''), 10);
      var prefix = raw.substring(0, raw.indexOf(numMatch[0]));
      var suffix = raw.substring(raw.indexOf(numMatch[0]) + numMatch[0].length);
      var duration = 1500;
      var start = 0;
      var startTime = null;
      function step(ts) {
        if (!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.floor(eased * target);
        el.textContent = prefix + current.toLocaleString() + suffix;
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = raw;
      }
      requestAnimationFrame(step);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting && !animated) {
            animated = true;
            els.forEach(animateCountUp);
            io.disconnect();
          }
        });
      }, { threshold: 0.3 });
      io.observe(section);
    }
  })();
</script>

{% schema %}
{
  "name": "Stellar Community Stats",
  "tag": "section",
  "class": "stellar-community-stats",
  "settings": [
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" }, { "value": "deepspace", "label": "Deep Space" }, { "value": "light", "label": "Light" }, { "value": "sand", "label": "Sand" }, { "value": "skyblue", "label": "Sky Blue" }, { "value": "custom", "label": "Custom" }], "default": "sand" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#FAF8F5" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#222222" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "stagger" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "45,000+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Dairy lovers served" }
    ] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Heading text", "default": "Heading" }, { "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h1", "label": "Extra Large" }, { "value": "h2", "label": "Large" }, { "value": "h3", "label": "Medium" }], "default": "h2" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Text" }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Button text", "default": "Learn More" }, { "type": "url", "id": "url", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "alt", "label": "Alt text" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["index"]
  },
  "presets": [
    {
      "name": "Stellar Community Stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "45,000+", "label": "Dairy lovers served" } },
        { "type": "stat", "settings": { "value": "4.9 ★", "label": "Average rating" } },
        { "type": "stat", "settings": { "value": "2,000+", "label": "Five-star reviews" } },
        { "type": "stat", "settings": { "value": "7x", "label": "Stronger than Lactaid" } }
      ]
    }
  ]
}
{% endschema %}