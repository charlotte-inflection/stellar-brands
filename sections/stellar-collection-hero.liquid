{% comment %}
  Stellar Collection Hero
  Full-width dark hero for collection pages.
  @concept-theme: section-type="collection-hero"
{% endcomment %}

<section
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="position:relative;{% if section.settings.section_height == 'full' %}min-height:100vh;{% endif %}display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <!-- Background image -->
  {% if section.settings.background_image != blank %}
    <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" aria-hidden="true">
  {% endif %}

  <!-- Overlay -->
  <div style="position:absolute;inset:0;background:{{ section.settings.overlay_color }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div style="position:relative;z-index:10;text-align:center;padding:0 1rem;">
    <p class="stellar-eyebrow" style="color:{% if section.settings.color_scheme == 'custom' %}inherit{% else %}var(--stellar-skyblue){% endif %};margin-bottom:1rem;">{{ section.settings.eyebrow }}</p>
    <h1 class="stellar-font-display" style="font-size:clamp(2.25rem,5vw,3.75rem);color:{% if section.settings.color_scheme == 'custom' %}inherit{% else %}var(--stellar-offwhite){% endif %};margin-bottom:1rem;">
      {{ section.settings.heading | default: collection.title }}
    </h1>
    <p class="stellar-font-body" style="color:{% if section.settings.color_scheme == 'custom' %}inherit{% else %}hsla(0,0%,96%,0.5){% endif %};max-width:28rem;margin:0 auto;line-height:1.75;{% if section.settings.color_scheme == 'custom' %}opacity:0.6;{% endif %}">
      {{ section.settings.description | default: collection.description }}
    </p>
  </div>
  <div class="stellar-container" style="max-width:48rem;margin:2rem auto 0;position:relative;z-index:10;text-align:center;">
    {% for block in section.blocks %}
      {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
        {% render 'stellar-standard-block', block: block %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Stellar Collection Hero",
  "tag": "section",
  "class": "stellar-collection-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop All" },
    { "type": "text", "id": "heading", "label": "Heading (blank = collection title)" },
    { "type": "textarea", "id": "description", "label": "Description (blank = collection desc)", "default": "From dairy freedom to heartburn relief — find the right solution for your body." },
    { "type": "header", "content": "Background & Overlay" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#22162B" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 80, "unit": "%" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "select", "id": "section_height", "label": "Section height", "options": [
      { "value": "auto", "label": "Auto (content)" },
      { "value": "full", "label": "Full viewport" }
    ], "default": "auto" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 120, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 120, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "deepspace", "label": "Deep Space" },
      { "value": "light", "label": "Light" },
      { "value": "sand", "label": "Sand" },
      { "value": "skyblue", "label": "Sky Blue" },
      { "value": "custom", "label": "Custom" }
    ], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "nebula" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "fade_up" }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Heading text", "default": "Heading" },{ "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h2", "label": "Large" },{ "value": "h3", "label": "Medium" },{ "value": "h4", "label": "Small" }], "default": "h3" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Text" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Button text", "default": "Learn More" },{ "type": "url", "id": "url", "label": "Link" },{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" },{ "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" },{ "type": "text", "id": "alt", "label": "Alt text" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["collection"]
  },
  "presets": [
    { "name": "Stellar Collection Hero" }
  ]
}
{% endschema %}