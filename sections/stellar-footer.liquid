{% comment %}
  Stellar Footer
  4-column footer with brand, menus, payment icons.
  @concept-theme: section-type="footer"
{% endcomment %}

<footer
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}border-top:1px solid hsla(0,0%,100%,0.05);"
>
  <div class="stellar-container">
    <div style="display:grid;grid-template-columns:1fr;gap:3rem;" class="stellar-footer-grid">
      <!-- Brand column -->
      <div>
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: height: 80 }}" alt="{{ shop.name }}" style="height:32px;margin-bottom:1rem;" loading="lazy">
        {% else %}
          <p class="stellar-font-display" style="font-size:1.25rem;margin-bottom:1rem;">{{ shop.name }}</p>
        {% endif %}
        <p class="stellar-font-body" style="font-size:0.875rem;opacity:0.5;max-width:20rem;line-height:1.6;">{{ section.settings.brand_description }}</p>
      </div>

      <!-- Menu columns from blocks -->
      {% for block in section.blocks %}
        {% if block.type == 'menu_column' %}
          <div {{ block.shopify_attributes }}>
            <p class="stellar-font-display" style="font-size:0.875rem;margin-bottom:1rem;">{{ block.settings.heading }}</p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
              {% for link in linklists[block.settings.menu].links %}
                <li>
                  <a href="{{ link.url }}" class="stellar-font-body" style="font-size:0.8125rem;opacity:0.5;text-decoration:none;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='0.5'">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Bottom bar -->
    <div style="margin-top:3rem;padding-top:1.5rem;border-top:1px solid hsla(0,0%,100%,0.05);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;">
      <p class="stellar-font-body" style="font-size:0.75rem;opacity:0.3;">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
      {% if section.settings.show_payment_icons %}
        <div style="display:flex;gap:0.5rem;opacity:0.3;">
          {{ 'visa' | payment_type_svg_tag }}
          {{ 'master' | payment_type_svg_tag }}
          {{ 'american_express' | payment_type_svg_tag }}
          {{ 'apple_pay' | payment_type_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>

  <style>
    @media (min-width: 768px) {
      .stellar-footer-grid { grid-template-columns: 2fr repeat({{ section.blocks.size }}, 1fr) !important; }
    }
  </style>
</footer>

{% schema %}
{
  "name": "Stellar Footer",
  "tag": "section",
  "class": "stellar-footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "textarea", "id": "brand_description", "label": "Brand description", "default": "The world's most powerful lactase supplement, designed to fit in your wallet." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 40, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "deepspace", "label": "Deep Space" },
      { "value": "light", "label": "Light" },
      { "value": "sand", "label": "Sand" },
      { "value": "skyblue", "label": "Sky Blue" },
      { "value": "custom", "label": "Custom" }
    ], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#F6F7F8" }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "Links" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stellar Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "Shop" } },
        { "type": "menu_column", "settings": { "heading": "Company" } },
        { "type": "menu_column", "settings": { "heading": "Support" } }
      ]
    }
  ]
}
{% endschema %}