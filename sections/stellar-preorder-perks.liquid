{% comment %}
  Stellar Preorder Perks
  3-column icon grid for waitlist benefits.
  @concept-theme: section-type="multicolumn"
{% endcomment %}

<section
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <div class="stellar-container" style="text-align:center;">
    {% if section.settings.eyebrow != blank %}
      <p class="stellar-eyebrow" style="color:var(--stellar-orange);margin-bottom:0.75rem;">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:3rem;color:#fff;">{{ section.settings.heading }}</h2>

    <div style="display:grid;grid-template-columns:1fr;gap:2rem;max-width:56rem;margin:0 auto;" class="stellar-perks-grid">
      {% for block in section.blocks %}
        {% if block.type == 'perk' %}
          <div {{ block.shopify_attributes }} class="stellar-hover-lift" style="padding:2rem 1.5rem;border-radius:1rem;border:1px solid hsla(0,0%,50%,0.1);text-align:center;">
            {% if block.settings.icon != blank %}
              <div style="width:3rem;height:3rem;margin:0 auto 1rem;">
                <img src="{{ block.settings.icon | image_url: width: 96 }}" alt="{{ block.settings.heading }}" style="width:100%;height:100%;object-fit:contain;" loading="lazy">
              </div>
            {% else %}
              <div style="width:3rem;height:3rem;margin:0 auto 1rem;border-radius:50%;background:hsla(30,90%,55%,0.1);display:flex;align-items:center;justify-content:center;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--stellar-orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            {% endif %}
            <h3 class="stellar-font-display" style="font-size:1rem;margin-bottom:0.5rem;color:#fff;">{{ block.settings.heading }}</h3>
            <p class="stellar-font-body" style="font-size:0.875rem;opacity:0.6;line-height:1.6;color:#fff;">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <style>
    @media (min-width: 768px) {
      .stellar-perks-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Stellar Preorder Perks",
  "tag": "section",
  "class": "stellar-preorder-perks",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WAITLIST PERKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Join Early?" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "stagger" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "First Access" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Be the first to try Nova before it hits shelves." }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "Stellar Preorder Perks",
      "blocks": [
        { "type": "perk", "settings": { "heading": "First Access", "description": "Be the first to try Nova before it hits shelves." } },
        { "type": "perk", "settings": { "heading": "Launch Discount", "description": "Exclusive pricing only available to waitlist members." } },
        { "type": "perk", "settings": { "heading": "Limited Edition", "description": "Special launch packaging not available after release." } }
      ]
    }
  ]
}
{% endschema %}