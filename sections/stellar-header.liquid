        { "type": "text", "id": "link_label", "label": "Link label", "info": "Defaults to the link title if left blank." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stellar Header",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "shop_link" },
