    { "type": "range", "id": "scroll_threshold", "label": "Scroll distance before solid", "min": 10, "max": 300, "step": 10, "default": 50, "unit": "px" },
    { "type": "checkbox", "id": "force_solid", "label": "Always start solid", "default": false },
    { "type": "checkbox", "id": "force_transparent", "label": "Always start transparent", "default": false },
    { "type": "header", "content": "Product / cart page style" },
    { "type": "color", "id": "product_bg_color", "label": "Solid page background", "default": "#22162B" },
    { "type": "color", "id": "product_text_color", "label": "Solid page text color", "default": "#F6F7F8" },
