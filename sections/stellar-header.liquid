  "class": "stellar-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 60, "step": 2, "default": 32, "unit": "px" },
    { "type": "link_list", "id": "menu", "label": "Desktop navigation menu", "default": "main-menu", "info": "Used for the inline desktop nav links." },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon (desktop)", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "enable_announcement", "label": "Enable announcement bar", "default": false },
    { "type": "inline_richtext", "id": "announcement_text", "label": "Text" },
    {
      "visible_if": "{{ section.settings.enable_announcement and section.settings.announcement_scroll == false }}",
      "type": "select",
      "id": "announcement_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "visible_if": "{{ section.settings.enable_announcement }}",
      "type": "checkbox",
      "id": "announcement_scroll",
      "label": "Scroll text",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.enable_announcement }}",
      "type": "color",
      "id": "announcement_bg",
      "label": "Background color",
      "default": "#000000"
    },
    {
