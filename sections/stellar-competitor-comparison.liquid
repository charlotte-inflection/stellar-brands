{% comment %}
  Stellar Competitor Comparison
  Full comparison table. All text editable via blocks.
  @concept-theme: section-type="custom-liquid" (comparison table)
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding:{{ section.settings.padding_top }}rem 0 {{ section.settings.padding_bottom }}rem;{% if section.settings.color_scheme == 'custom' %}background:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <div class="stellar-container" style="text-align:center;">
    <p class="stellar-eyebrow" style="color:var(--stellar-skyblue);margin-bottom:0.75rem;">{{ section.settings.eyebrow }}</p>
    <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:0.5rem;">
      {{ section.settings.heading }}
    </h2>
    <p class="stellar-font-body" style="opacity:0.5;margin-bottom:3rem;">{{ section.settings.subheading }}</p>
  </div>

  <div class="stellar-scrollbar-hide" style="max-width:64rem;margin:0 auto;overflow-x:auto;padding:0 1rem;">
    <table class="stellar-font-body" style="width:100%;min-width:40rem;font-size:0.875rem;border-collapse:collapse;">
      <thead>
        <tr style="border-bottom:1px solid hsla(0,0%,100%,0.1);">
          <th style="text-align:left;padding:1rem;color:hsla(0,0%,96%,0.4);font-weight:normal;width:180px;">Feature</th>
          {% for block in section.blocks %}
            {% if block.type == 'competitor' %}
              <th style="text-align:center;padding:1rem;{% if block.settings.highlight %}border-left:1px solid hsla(211,60%,79%,0.2);border-right:1px solid hsla(211,60%,79%,0.2);background:hsla(211,60%,79%,0.05);border-top:2px solid var(--stellar-skyblue);{% endif %}">
                <span {% if block.settings.highlight %}class="stellar-font-display" style="color:var(--stellar-skyblue);font-size:1rem;"{% else %}style="opacity:0.5;"{% endif %}>
                  {{ block.settings.name }}
                </span>
              </th>
            {% endif %}
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          {% if block.type == 'row' %}
            <tr style="border-bottom:1px solid hsla(0,0%,100%,0.05);" {{ block.shopify_attributes }}>
              <td style="opacity:0.6;padding:1rem;font-size:0.75rem;">{{ block.settings.label }}</td>
              {%- assign col_idx = 0 -%}
              {%- for b in section.blocks -%}
                {%- if b.type == 'competitor' -%}
                  {%- assign col_idx = col_idx | plus: 1 -%}
                  {%- assign val_key = 'col_' | append: col_idx -%}
                  {%- assign val = block.settings[val_key] -%}
                  <td style="text-align:center;padding:1rem;font-size:0.75rem;{% if b.settings.highlight %}border-left:1px solid hsla(211,60%,79%,0.2);border-right:1px solid hsla(211,60%,79%,0.2);background:hsla(211,60%,79%,0.05);font-weight:500;{% else %}opacity:0.5;{% endif %}">
                    {%- if val == 'true' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--stellar-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- elsif val == 'false' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="hsla(0,60%,60%,0.6)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    {%- elsif val == '—' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="hsla(0,0%,96%,0.2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {%- else -%}
                      {{ val }}
                    {%- endif -%}
                  </td>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if section.settings.cta_text != blank %}
    <div style="text-align:center;margin-top:2.5rem;">
      <a href="{{ section.settings.cta_url }}" class="stellar-font-body stellar-hover-lift" style="display:inline-block;padding:0.625rem 2rem;border-radius:0.5rem;background:var(--stellar-skyblue);color:var(--stellar-black);font-weight:500;text-decoration:none;">
        {{ section.settings.cta_text }}
      </a>
    </div>
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
      <div class="stellar-container" style="margin-top:2rem;">
        {% render 'stellar-standard-block', block: block %}
      </div>
    {% endif %}
  {% endfor %}
</section>

{% schema %}
{
  "name": "Stellar Competitor Tbl",
  "tag": "section",
  "class": "stellar-competitor-comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Milky Stacks Up" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "See why 45,000+ dairy lovers switched." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Milky Ultra" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "constellation" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    { "type": "competitor", "name": "Column", "settings": [{ "type": "text", "id": "name", "label": "Brand name", "default": "Milky Ultra" },{ "type": "checkbox", "id": "highlight", "label": "Highlight column", "default": false }] },
    { "type": "row", "name": "Row", "settings": [{ "type": "text", "id": "label", "label": "Feature label", "default": "Feature name" },{ "type": "text", "id": "col_1", "label": "Column 1 value" },{ "type": "text", "id": "col_2", "label": "Column 2 value" },{ "type": "text", "id": "col_3", "label": "Column 3 value" },{ "type": "text", "id": "col_4", "label": "Column 4 value" },{ "type": "text", "id": "col_5", "label": "Column 5 value" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Heading" },{ "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h2", "label": "Large" },{ "value": "h3", "label": "Medium" },{ "value": "h4", "label": "Small" }], "default": "h3" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Content", "default": "<p>Body text</p>" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Label", "default": "Learn More" },{ "type": "url", "id": "url", "label": "Link" },{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" },{ "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" },{ "type": "text", "id": "alt", "label": "Alt text", "default": "Image" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["index"]
  },
  "presets": [
    {
      "name": "Stellar Competitor Tbl",
      "blocks": [
        { "type": "competitor", "settings": { "name": "Milky Ultra", "highlight": true } },
        { "type": "competitor", "settings": { "name": "MilkTab", "highlight": false } },
        { "type": "competitor", "settings": { "name": "DairyPill", "highlight": false } },
        { "type": "competitor", "settings": { "name": "Lactaid", "highlight": false } },
        { "type": "row", "settings": { "label": "Lactase per dose", "col_1": "21,000 FCC", "col_2": "27,000 FCC", "col_3": "18,000 FCC", "col_4": "3,000 FCC" } },
        { "type": "row", "settings": { "label": "Additional enzymes", "col_1": "—", "col_2": "Protease + Lipase", "col_3": "—", "col_4": "—" } },
        { "type": "row", "settings": { "label": "Format", "col_1": "Credit-card (wallet)", "col_2": "Box of pills", "col_3": "Keychain pod", "col_4": "Bottle of pills" } },
        { "type": "row", "settings": { "label": "Fits in wallet", "col_1": "true", "col_2": "false", "col_3": "false", "col_4": "false" } },
        { "type": "row", "settings": { "label": "Doses per pack", "col_1": "24", "col_2": "45", "col_3": "30–180", "col_4": "32" } },
        { "type": "row", "settings": { "label": "Subscription savings", "col_1": "10%", "col_2": "10–30%", "col_3": "10%", "col_4": "None" } },
        { "type": "row", "settings": { "label": "Free shipping", "col_1": "On subs & $40+", "col_2": "On subs", "col_3": "On $40+", "col_4": "N/A (retail)" } },
        { "type": "row", "settings": { "label": "Money-back guarantee", "col_1": "60 days", "col_2": "30 days", "col_3": "30 days", "col_4": "None" } },
        { "type": "row", "settings": { "label": "NSF Certified", "col_1": "true", "col_2": "false", "col_3": "false", "col_4": "false" } },
        { "type": "row", "settings": { "label": "Third-party tested", "col_1": "Yes (ISO 17025)", "col_2": "false", "col_3": "true", "col_4": "false" } },
        { "type": "row", "settings": { "label": "HSA/FSA eligible", "col_1": "true", "col_2": "false", "col_3": "true", "col_4": "false" } },
        { "type": "row", "settings": { "label": "Price from", "col_1": "$34", "col_2": "$29", "col_3": "$24.99", "col_4": "~$12" } }
      ]
    }
  ]
}
{% endschema %}
