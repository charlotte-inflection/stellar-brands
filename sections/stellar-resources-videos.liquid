{% comment %}
  Stellar Resources Videos
  Video thumbnail grid with play buttons and image zoom.
  @concept-theme: section-type="multicolumn"
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding:{{ section.settings.padding_top }}rem 0 {{ section.settings.padding_bottom }}rem;{% if section.settings.color_scheme == 'custom' %}background:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
  {% if section.settings.toggle_group != blank %}data-toggle-group="{{ section.settings.toggle_group }}"{% endif %}
>
  <div class="stellar-container" style="max-width:56rem;margin:0 auto;text-align:center;">
    <h2 class="stellar-font-display" style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:0.5rem;{% if section.settings.color_scheme == 'custom' %}color:inherit;{% else %}color:var(--stellar-offwhite);{% endif %}">{{ section.settings.heading }}</h2>
    <p class="stellar-font-body" style="{% if section.settings.color_scheme == 'custom' %}color:inherit;opacity:0.5;{% else %}color:hsla(0,0%,100%,0.4);{% endif %}margin-bottom:3rem;">{{ section.settings.subheading }}</p>
    <div style="display:grid;grid-template-columns:1fr;gap:1.5rem;" class="stellar-grid-md-3">
      {% for block in section.blocks %}
        {% if block.type == 'video' %}
          <div class="stellar-hover-lift" style="cursor:pointer;" {{ block.shopify_attributes }}>

            <h3 class="stellar-font-display" style="font-size:1.125rem;text-align:left;{% if section.settings.color_scheme == 'custom' %}color:inherit;{% else %}color:var(--stellar-offwhite);{% endif %}margin-bottom:0.75rem;">{{ block.settings.title }}</h3>

            {% if block.settings.video_file != blank %}
              {%- comment -%} Uploaded video from Shopify media library {%- endcomment -%}
              {%- assign poster_url = '' -%}
              {%- if block.settings.thumbnail != blank -%}
                {%- assign poster_url = block.settings.thumbnail | image_url: width: 1200 -%}
              {%- endif -%}
              <div style="aspect-ratio:16/9;border-radius:1rem;overflow:hidden;">
                <video
                  controls
                  playsinline
                  preload="auto"
                  {% if poster_url != '' %}poster="{{ poster_url }}"{% endif %}
                  style="width:100%;height:100%;object-fit:cover;"
                >
                  {% for source in block.settings.video_file.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>
              </div>

            {% else %}
              {%- comment -%} Fallback: external URL with thumbnail + play button {%- endcomment -%}
              <div class="stellar-img-zoom" style="aspect-ratio:16/9;border-radius:1rem;overflow:hidden;position:relative;{% if block.settings.thumbnail != blank %}{% else %}background:var(--stellar-deepspace);border:1px solid hsla(0,0%,100%,0.05);{% endif %}">
                {% if block.settings.thumbnail != blank %}
                  <img src="{{ block.settings.thumbnail | image_url: width: 600 }}" alt="{{ block.settings.title }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                {% endif %}
                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
                  {% if block.settings.video_url != blank %}<a href="{{ block.settings.video_url }}" target="_blank" rel="noopener" style="text-decoration:none;">{% endif %}
                  <div style="width:3rem;height:3rem;border-radius:50%;background:hsla(211,60%,79%,0.2);display:flex;align-items:center;justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--stellar-offwhite)" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  </div>
                  {% if block.settings.video_url != blank %}</a>{% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div style="max-width:48rem;margin:2rem auto 0;">
      {% for block in section.blocks %}
        {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
          {% render 'stellar-standard-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stellar Resources Videos",
  "tag": "section",
  "class": "stellar-resources-videos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Video Resources" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Watch, learn, and eat dairy with confidence." },
    { "type": "header", "content": "Resources toggle" },
    { "type": "text", "id": "toggle_group", "label": "Toggle group", "info": "Used with the Resources Toggle section. Set to 'lactose' or 'heartburn' to control visibility via tabs. Leave blank if not on a toggled page." },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How Lactase Works (60 sec)" },
        { "type": "video", "id": "video_file", "label": "Video file" },
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail image" },
        { "type": "url", "id": "video_url", "label": "External video URL (fallback)" }
      ]
    },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Heading" },{ "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h2", "label": "Large" },{ "value": "h3", "label": "Medium" },{ "value": "h4", "label": "Small" }], "default": "h3" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Content", "default": "<p>Body text</p>" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Label", "default": "Learn More" },{ "type": "url", "id": "url", "label": "Link" },{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" },{ "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" },{ "type": "text", "id": "alt", "label": "Alt text", "default": "Image" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "Stellar Resources Videos",
      "blocks": [
        { "type": "video", "settings": { "title": "How Lactase Works (60 sec)" } },
        { "type": "video", "settings": { "title": "Milky vs Lactaid: The Truth" } },
        { "type": "video", "settings": { "title": "Dr. Seidman Explains Lactose Intolerance" } }
      ]
    }
  ]
}
{% endschema %}