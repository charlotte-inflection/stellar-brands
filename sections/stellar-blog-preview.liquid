{% comment %}
  Stellar Blog Preview
  Three blog post cards on light background.
  @concept-theme: section-type="blog-posts"
{% endcomment %}

<section
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="{% if section.settings.section_height == 'full' %}min-height:100vh;{% endif %}padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <div class="stellar-container">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3rem;">
      <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.view_all_url != blank %}
        <a href="{{ section.settings.view_all_url }}" class="stellar-font-body" style="font-size:0.875rem;opacity:0.5;text-decoration:none;">
          View All →
        </a>
      {% endif %}
    </div>

    {% if section.settings.blog != blank %}
      <div style="display:grid;gap:1.5rem;" class="stellar-blog-grid">
        {% for article in blogs[section.settings.blog].articles limit: 3 %}
          <a href="{{ article.url }}" style="text-decoration:none;color:inherit;" class="stellar-blog-card-link">
            <div style="aspect-ratio:4/3;border-radius:1rem;overflow:hidden;margin-bottom:1rem;background:hsla(0,0%,13%,0.05);">
              {% if article.image %}
                <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
              {% endif %}
            </div>
            <h3 class="stellar-font-display" style="font-size:1.125rem;margin-bottom:0.5rem;">{{ article.title }}</h3>
            <p class="stellar-font-body" style="font-size:0.875rem;opacity:0.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
              {{ article.excerpt_or_content | strip_html | truncate: 120 }}
            </p>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p class="stellar-font-body" style="opacity:0.5;text-align:center;">Select a blog in the theme editor to display posts.</p>
    {% endif %}
  </div>

  <div class="stellar-container" style="max-width:48rem;margin:2rem auto 0;">
    {% for block in section.blocks %}
      {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
        {% render 'stellar-standard-block', block: block %}
      {% endif %}
    {% endfor %}
  </div>

  <style>
    @media (min-width: 768px) {
      .stellar-blog-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Stellar Blog Preview",
  "tag": "section",
  "class": "stellar-blog-preview",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "url", "id": "view_all_url", "label": "View all link" },
    {
      "type": "header",
      "content": "Layout & Style"
    },
    { "type": "select", "id": "section_height", "label": "Section height", "options": [
      { "value": "auto", "label": "Auto (content)" },
      { "value": "full", "label": "Full viewport" }
    ], "default": "auto" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "deepspace", "label": "Deep Space" },
      { "value": "light", "label": "Light" },
      { "value": "sand", "label": "Sand" },
      { "value": "skyblue", "label": "Sky Blue" },
      { "value": "custom", "label": "Custom" }
    ], "default": "light" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#F6F7F8" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#222222" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [
      { "value": "none", "label": "None" },
      { "value": "stars", "label": "Stars" },
      { "value": "constellation", "label": "Constellation" },
      { "value": "nebula", "label": "Nebula" }
    ], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "fade_up" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "text", "label": "Heading text", "default": "Heading" },
        { "type": "select", "id": "size", "label": "Size", "options": [
          { "value": "h2", "label": "Large" },
          { "value": "h3", "label": "Medium" },
          { "value": "h4", "label": "Small" }
        ], "default": "h3" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "text", "label": "Button text", "default": "Learn More" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "outline", "label": "Outline" }
        ], "default": "primary" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "text", "label": "Badge text", "default": "New" },
        { "type": "select", "id": "color", "label": "Color", "options": [
          { "value": "purple", "label": "Purple" },
          { "value": "orange", "label": "Orange" },
          { "value": "skyblue", "label": "Sky Blue" },
          { "value": "green", "label": "Green" }
        ], "default": "purple" }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": [
        { "type": "range", "id": "height", "label": "Height", "min": 1, "max": 4, "step": 1, "default": 1, "unit": "px" },
        { "type": "range", "id": "opacity", "label": "Opacity", "min": 5, "max": 50, "step": 5, "default": 10, "unit": "%" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  },
  "presets": [
    { "name": "Stellar Blog Preview" }
  ]
}
{% endschema %}
