{% comment %}
  Stellar Preorder Hero
  Countdown timer, email capture, orange accent for Nova preorder.
  @concept-theme: section-type="image-banner"
{% endcomment %}

<style>
  @media (max-width: 749px) {
    #stellar-preorder-hero-{{ section.id }} {
      min-height: auto !important;
      padding-top: 3rem !important;
      padding-bottom: 3rem !important;
    }
    #stellar-preorder-hero-{{ section.id }} h1 {
      margin-bottom: 1rem !important;
    }
    #stellar-preorder-hero-{{ section.id }} .stellar-countdown {
      margin-bottom: 1.5rem !important;
    }
    #stellar-preorder-hero-{{ section.id }} .stellar-preorder-form-wrap {
      flex-direction: column !important;
      max-width: 100% !important;
    }
    #stellar-preorder-hero-{{ section.id }} .stellar-preorder-form-wrap input[type="email"],
    #stellar-preorder-hero-{{ section.id }} .stellar-preorder-form-wrap button {
      width: 100% !important;
      flex: none !important;
      height: 3rem;
      box-sizing: border-box;
    }
  }
</style>

<section
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:{{ section.settings.padding_top }}px 1rem {{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
  id="stellar-preorder-hero-{{ section.id }}"
>
  {% if section.settings.background_image != blank %}
    <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" loading="eager" aria-hidden="true">
  {% endif %}
  <div style="position:absolute;inset:0;background:{{ section.settings.overlay_color }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div style="position:relative;z-index:10;text-align:center;max-width:36rem;">
    {% if section.settings.badge_text != blank %}
      <div style="margin-bottom:1.5rem;">
        <span class="stellar-badge" style="background:hsla(30,90%,55%,0.15);color:var(--stellar-orange);">{{ section.settings.badge_text }}</span>
      </div>
    {% endif %}

    <h1 class="stellar-font-display" style="font-size:clamp(2.25rem,5vw,4rem);color:var(--stellar-offwhite);line-height:1.1;margin-bottom:1.5rem;">
      {{ section.settings.heading }}
    </h1>

    <p class="stellar-font-body" style="color:hsla(0,0%,96%,0.6);font-size:1.125rem;line-height:1.75;margin-bottom:2rem;">
      {{ section.settings.description }}
    </p>

    <!-- Countdown -->
    {% if section.settings.launch_date != blank %}
      <div style="display:flex;justify-content:center;gap:1.5rem;margin-bottom:2.5rem;" class="stellar-countdown" data-target="{{ section.settings.launch_date }}">
        {% assign countdown_units = 'days,hours,mins,secs' | split: ',' %}
        {% for unit in countdown_units %}
          <div style="text-align:center;">
            <p class="stellar-font-display stellar-countdown-{{ unit }}" style="font-size:clamp(1.5rem,3vw,2.5rem);color:var(--stellar-orange);">00</p>
            <p class="stellar-eyebrow" style="color:hsla(0,0%,96%,0.4);margin-top:0.25rem;">{{ unit | capitalize }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Email capture -->
    {% if section.settings.form_mode == 'klaviyo' %}
      <form action="{{ section.settings.klaviyo_action_url }}" method="post">
        {% if section.settings.klaviyo_list_id != blank %}
          <input type="hidden" name="g" value="{{ section.settings.klaviyo_list_id }}">
        {% endif %}
        <div class="stellar-preorder-form-wrap" style="display:flex;gap:0.5rem;max-width:28rem;margin:0 auto;">
          <input type="email" name="email" placeholder="your@email.com" required class="stellar-font-body" style="flex:1;border-radius:0.5rem;background:hsla(0,0%,100%,0.1);border:1px solid hsla(0,0%,100%,0.1);padding:0.75rem 1rem;color:var(--stellar-offwhite);font-size:0.875rem;">
          <button type="submit" class="stellar-font-body" style="padding:0.75rem 1.5rem;border-radius:0.5rem;background:var(--stellar-orange);color:var(--stellar-black);font-weight:500;border:none;cursor:pointer;">{{ section.settings.cta_text }}</button>
        </div>
      </form>
    {% else %}
      {% form 'customer', id: 'stellar-preorder' %}
        <input type="hidden" name="contact[tags]" value="preorder,nova">
        <div class="stellar-preorder-form-wrap" style="display:flex;gap:0.5rem;max-width:28rem;margin:0 auto;">
          <input type="email" name="contact[email]" placeholder="your@email.com" required class="stellar-font-body" style="flex:1;border-radius:0.5rem;background:hsla(0,0%,100%,0.1);border:1px solid hsla(0,0%,100%,0.1);padding:0.75rem 1rem;color:var(--stellar-offwhite);font-size:0.875rem;">
          <button type="submit" class="stellar-font-body" style="padding:0.75rem 1.5rem;border-radius:0.5rem;background:var(--stellar-orange);color:var(--stellar-black);font-weight:500;border:none;cursor:pointer;">{{ section.settings.cta_text }}</button>
        </div>
      {% endform %}
    {% endif %}

    {% if section.settings.trust_text != blank %}
      <p class="stellar-font-body" style="color:hsla(0,0%,96%,0.3);font-size:0.75rem;margin-top:1rem;">{{ section.settings.trust_text }}</p>
    {% endif %}
  </div>
</section>

<script>
  (function(){
    var el = document.querySelector('#stellar-preorder-hero-{{ section.id }} .stellar-countdown');
    if (!el) return;
    var target = new Date(el.dataset.target).getTime();
    function tick() {
      var now = Date.now();
      var diff = Math.max(0, target - now);
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.querySelector('.stellar-countdown-days').textContent = String(d).padStart(2,'0');
      el.querySelector('.stellar-countdown-hours').textContent = String(h).padStart(2,'0');
      el.querySelector('.stellar-countdown-mins').textContent = String(m).padStart(2,'0');
      el.querySelector('.stellar-countdown-secs').textContent = String(s).padStart(2,'0');
      if (diff > 0) requestAnimationFrame(tick);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

{% schema %}
{
  "name": "Stellar Preorder Hero",
  "tag": "section",
  "class": "stellar-preorder-hero",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "COMING SOON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nova Is Almost Here" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our new heartburn relief formula, built with the same radical transparency as Milky." },
    { "type": "text", "id": "launch_date", "label": "Launch date (ISO)", "default": "2026-06-01T00:00:00", "info": "Format: YYYY-MM-DDTHH:MM:SS" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Join Waitlist" },
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "No spam. Unsubscribe anytime." },
    { "type": "header", "content": "Form Integration" },
    { "type": "select", "id": "form_mode", "label": "Form mode", "options": [{ "value": "shopify", "label": "Shopify" },{ "value": "klaviyo", "label": "Klaviyo" }], "default": "shopify" },
    { "type": "text", "id": "klaviyo_action_url", "label": "Klaviyo form action URL" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID" },
    { "type": "header", "content": "Background & Overlay" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#22162B" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 70, "unit": "%" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "nebula" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    { "name": "Stellar Preorder Hero" }
  ]
}
{% endschema %}