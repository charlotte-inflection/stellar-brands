{% comment %}
  Stellar Collection
  Product grid with individually configurable product blocks.
  Each block maps to a product with custom title, JTBD label, and colors.
{% endcomment %}

<section
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="stellar-container" style="max-width:64rem;text-align:center;">
    {% if section.settings.heading != blank %}
      <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:2rem;color:{% if section.settings.color_scheme == 'custom' %}inherit{% else %}var(--stellar-offwhite){% endif %};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:2rem;text-align:left;">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            {%- assign card_product = all_products[block.settings.product_handle] -%}
            {%- if card_product != blank or request.design_mode -%}
              <div {{ block.shopify_attributes }} style="border-radius:1rem;overflow:hidden;{% if block.settings.card_bg != blank %}background:{{ block.settings.card_bg }};{% endif %}">
                {%- assign card_image = block.settings.custom_image | default: card_product.featured_image -%}
                {% if card_image != blank %}
                  <a href="{{ card_product.url }}" style="display:block;aspect-ratio:1;overflow:hidden;">
                    <img src="{{ card_image | image_url: width: 800 }}" alt="{{ card_product.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy" width="400" height="400" />
                  </a>
                {% endif %}
                <div style="padding:1rem 1.25rem 1.25rem;">
                  {% if block.settings.jtbd_label != blank %}
                    <p class="stellar-eyebrow" style="{% if block.settings.jtbd_color != blank %}color:{{ block.settings.jtbd_color }};{% elsif section.settings.color_scheme == 'custom' %}color:inherit;opacity:0.6;{% else %}color:var(--stellar-purple);{% endif %}margin-bottom:0.375rem;">
                      {{ block.settings.jtbd_label }}
                    </p>
                  {% endif %}
                  <h3 class="stellar-font-display" style="font-size:1.25rem;margin-bottom:0.25rem;">
                    <a href="{{ card_product.url }}" style="color:inherit;text-decoration:none;">{{ block.settings.display_title | default: card_product.title }}</a>
                  </h3>
                  {% if card_product != blank %}
                    <p class="stellar-font-body" style="font-weight:700;font-size:1rem;">
                      From {{ card_product.price | money }}
                    </p>
                  {% endif %}
                </div>
              </div>
            {%- endif -%}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.cta_text != blank %}
      <div style="margin-top:2.5rem;">
        <a href="{{ section.settings.cta_url }}" class="stellar-font-body" style="display:inline-block;padding:0.75rem 2rem;border-radius:2rem;{% if section.settings.color_scheme == 'custom' %}border:1px solid;color:inherit;{% else %}background:var(--stellar-purple);color:#fff;{% endif %}text-decoration:none;font-weight:600;">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Stellar Collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "cta_text", "label": "CTA text" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 8, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 8, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "deepspace", "label": "Deep Space" },
      { "value": "light", "label": "Light" },
      { "value": "sand", "label": "Sand" },
      { "value": "skyblue", "label": "Sky Blue" },
      { "value": "custom", "label": "Custom" }
    ], "default": "light" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#ffffff" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#222222" },
    { "type": "select", "id": "reveal_animation", "label": "Reveal animation", "options": [
      { "value": "none", "label": "None" },
      { "value": "fade_up", "label": "Fade up" }
    ], "default": "none" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product_handle", "label": "Product" },
        { "type": "text", "id": "display_title", "label": "Display title", "info": "Overrides the product title." },
        { "type": "text", "id": "jtbd_label", "label": "JTBD label", "info": "Shown above the title." },
        { "type": "color", "id": "jtbd_color", "label": "JTBD label color" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image", "info": "Overrides the product image." },
        { "type": "color", "id": "card_bg", "label": "Card background" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stellar Collection",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
