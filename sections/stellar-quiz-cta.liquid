{% comment %}
  Stellar Quiz CTA Banner
  Gradient banner with CTA to quiz page.
  @concept-theme: section-type="rich-text"
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="position:relative;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;overflow:hidden;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}background:linear-gradient(135deg, var(--stellar-purple), var(--stellar-skyblue));"
>
  <div style="position:relative;z-index:10;text-align:center;max-width:40rem;margin:0 auto;padding:0 1rem;">
    <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,3rem);color:white;margin-bottom:1rem;line-height:1.2;">
      {{ section.settings.heading }}
    </h2>
    <p class="stellar-font-body" style="color:hsla(0,0%,100%,0.7);font-size:1.125rem;margin-bottom:1rem;">
      {{ section.settings.subheading }}
    </p>
    {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_url }}" class="stellar-font-body" style="display:inline-block;padding:0.75rem 2.5rem;border-radius:0.5rem;background:white;color:var(--stellar-black);font-weight:500;text-decoration:none;font-size:1rem;margin-bottom:1rem;">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
    {% if section.settings.nova_text != blank %}
      <p class="stellar-font-body" style="font-size:0.875rem;margin-top:0.5rem;">
        <a href="{{ section.settings.nova_url }}" style="color:hsla(0,0%,100%,0.4);text-decoration:none;">
          {{ section.settings.nova_text }}
        </a>
      </p>
    {% endif %}
  </div>

  <div class="stellar-container" style="max-width:48rem;margin:2rem auto 0;">
    {% for block in section.blocks %}
      {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
        {% render 'stellar-standard-block', block: block %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Stellar Quiz CTA",
  "tag": "section",
  "class": "stellar-quiz-cta",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure Which Milky Is Right For You?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Take our 60-second quiz and get a personalized recommendation." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Take the Quiz" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "text", "id": "nova_text", "label": "Nova text", "default": "Or learn about Nova for heartburn relief →" },
    { "type": "url", "id": "nova_url", "label": "Nova link" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" }, { "value": "deepspace", "label": "Deep Space" }, { "value": "light", "label": "Light" }, { "value": "sand", "label": "Sand" }, { "value": "skyblue", "label": "Sky Blue" }, { "value": "custom", "label": "Custom" }], "default": "dark" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#222222" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Heading text", "default": "Heading" }, { "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h1", "label": "Extra Large" }, { "value": "h2", "label": "Large" }, { "value": "h3", "label": "Medium" }], "default": "h2" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Text" }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Button text", "default": "Learn More" }, { "type": "url", "id": "url", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "alt", "label": "Alt text" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "presets": [{ "name": "Stellar Quiz CTA" }]
}
{% endschema %}
