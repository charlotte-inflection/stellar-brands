{% comment %}
  Stellar Preorder Personas
  3-column "who is this for" grid.
  @concept-theme: section-type="multicolumn"
{% endcomment %}

<section
  class="{% case section.settings.color_scheme %}{% when 'dark' %}stellar-bg-dark{% when 'deepspace' %}stellar-bg-deepspace{% when 'light' %}stellar-bg-light{% when 'sand' %}stellar-bg-sand{% when 'skyblue' %}stellar-bg-skyblue{% endcase %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <div class="stellar-container" style="text-align:center;">
    {% if section.settings.eyebrow != blank %}
      <p class="stellar-eyebrow" style="color:var(--stellar-orange);margin-bottom:0.75rem;">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:3rem;">{{ section.settings.heading }}</h2>

    <div style="display:grid;grid-template-columns:1fr;gap:2rem;max-width:56rem;margin:0 auto;" class="stellar-personas-grid">
      {% for block in section.blocks %}
        {% if block.type == 'persona' %}
          <div {{ block.shopify_attributes }} class="stellar-hover-lift" style="padding:2rem 1.5rem;border-radius:1rem;border:1px solid hsla(30,90%,55%,0.2);text-align:center;">
            {% if block.settings.emoji != blank %}
              <p style="font-size:2rem;margin-bottom:1rem;">{{ block.settings.emoji }}</p>
            {% endif %}
            <h3 class="stellar-font-display" style="font-size:1.125rem;margin-bottom:0.5rem;">{{ block.settings.heading }}</h3>
            <p class="stellar-font-body" style="font-size:0.875rem;opacity:0.6;line-height:1.6;">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <style>
    @media (min-width: 768px) {
      .stellar-personas-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Stellar Preorder Personas",
  "tag": "section",
  "class": "stellar-preorder-personas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHO IS NOVA FOR?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for Real People" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "sand" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#E5DDD3" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#222222" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "stagger" }
  ],
  "blocks": [
    {
      "type": "persona",
      "name": "Persona",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🔥" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Spicy Food Lover" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "You love bold flavors but hate the aftermath. Nova lets you enjoy every bite." }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page", "product"]
  },
  "presets": [
    {
      "name": "Stellar Preorder Personas",
      "blocks": [
        { "type": "persona", "settings": { "emoji": "🔥", "heading": "The Spicy Food Lover", "description": "You love bold flavors but hate the aftermath. Nova lets you enjoy every bite." } },
        { "type": "persona", "settings": { "emoji": "🍕", "heading": "The Late-Night Snacker", "description": "Pizza at midnight shouldn't mean regret at 2am. Nova has your back." } },
        { "type": "persona", "settings": { "emoji": "💼", "heading": "The On-the-Go Pro", "description": "Business dinners, travel meals — heartburn doesn't fit your schedule." } }
      ]
    }
  ]
}
{% endschema %}