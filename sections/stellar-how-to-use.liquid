{% comment %}
  Stellar How to Use
  Three-step cards on dark background.
  @concept-theme: section-type="multicolumn" with image_with_text blocks
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
  {% if section.settings.toggle_group != blank %}data-toggle-group="{{ section.settings.toggle_group }}"{% endif %}
>
  <div class="stellar-container" style="text-align:center;">
    <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);color:{% if section.settings.color_scheme == 'custom' %}inherit{% else %}var(--stellar-offwhite){% endif %};margin-bottom:1rem;">
      {{ section.settings.heading }}
    </h2>
    <p class="stellar-font-body" style="color:hsla(0,0%,96%,0.5);margin-bottom:4rem;max-width:28rem;margin-left:auto;margin-right:auto;">
      {{ section.settings.subheading }}
    </p>

    <div style="display:grid;gap:1.5rem;max-width:64rem;margin:0 auto;" class="stellar-how-to-use-grid{% if section.settings.mobile_scroll %} stellar-how-to-use-scroll{% endif %}">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div {{ block.shopify_attributes }} style="border-radius:1rem;border:1px solid hsla(0,0%,100%,0.1);background:hsla(0,0%,100%,0.05);overflow:hidden;">
            {% if block.settings.image != blank %}
              <div style="aspect-ratio:4/3;overflow:hidden;">
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
              </div>
            {% else %}
              <div style="aspect-ratio:4/3;background:linear-gradient(135deg, hsla(246,40%,57%,0.2), hsla(211,60%,79%,0.1));"></div>
            {% endif %}
            <div style="padding:1.5rem;">
              <span class="stellar-font-display" style="font-size:2.5rem;color:hsla(211,60%,79%,0.3);">{{ block.settings.step_number }}</span>
              <h3 class="stellar-font-display" style="font-size:1.5rem;color:{% if section.settings.color_scheme == 'custom' %}inherit{% else %}var(--stellar-offwhite){% endif %};margin:0.5rem 0;">{{ block.settings.title }}</h3>
              <p class="stellar-font-body" style="color:hsla(0,0%,96%,0.6);font-size:0.875rem;">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div style="max-width:48rem;margin:2rem auto 0;">
      {% for block in section.blocks %}
        {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
          {% render 'stellar-standard-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <style>
    @media (min-width: 768px) {
      .stellar-how-to-use-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
    /* Mobile horizontal scroll when enabled */
    @media (max-width: 767px) {
      .stellar-how-to-use-scroll {
        display: flex !important;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        gap: 1rem;
        padding-bottom: 0.5rem;
      }
      .stellar-how-to-use-scroll > * {
        flex: 0 0 80%;
        min-width: 260px;
        max-width: 320px;
        scroll-snap-align: start;
      }
      /* Hide scrollbar while keeping scroll functional */
      .stellar-how-to-use-scroll::-webkit-scrollbar { display: none; }
      .stellar-how-to-use-scroll { -ms-overflow-style: none; scrollbar-width: none; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Stellar How to Use",
  "tag": "section",
  "class": "stellar-how-to-use",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to Use Milky" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Three simple steps. Zero dairy drama." },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "header", "content": "Resources toggle" },
    { "type": "text", "id": "toggle_group", "label": "Toggle group", "info": "Used with the Resources Toggle section. Set to 'lactose' or 'heartburn' to control visibility via tabs. Leave blank if not on a toggled page." },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Horizontal scroll on mobile", "default": false, "info": "Cards scroll horizontally on mobile instead of stacking vertically." },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" }, { "value": "deepspace", "label": "Deep Space" }, { "value": "light", "label": "Light" }, { "value": "sand", "label": "Sand" }, { "value": "skyblue", "label": "Sky Blue" }, { "value": "custom", "label": "Custom" }], "default": "deepspace" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#1a1625" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "step_number", "label": "Step number", "default": "01" },
      { "type": "text", "id": "title", "label": "Title", "default": "Grab" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Slide your Milky card out of your wallet." },
      { "type": "image_picker", "id": "image", "label": "Step image" }
    ] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Heading text", "default": "Heading" }, { "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h1", "label": "Extra Large" }, { "value": "h2", "label": "Large" }, { "value": "h3", "label": "Medium" }], "default": "h2" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Text" }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Button text", "default": "Learn More" }, { "type": "url", "id": "url", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "alt", "label": "Alt text" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "presets": [
    {
      "name": "Stellar How to Use",
      "blocks": [
        { "type": "step", "settings": { "step_number": "01", "title": "Grab", "description": "Slide your Milky card out of your wallet." } },
        { "type": "step", "settings": { "step_number": "02", "title": "Chew", "description": "Chew or swallow 1 tablet with your first bite of dairy." } },
        { "type": "step", "settings": { "step_number": "03", "title": "Enjoy", "description": "Eat without limits. Take another every 30-45 min as needed." } }
      ]
    }
  ]
}
{% endschema %}
