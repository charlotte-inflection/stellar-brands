{% comment %}
  Stellar Product Reviews (PDP)
  Review summary + cards with hover lift.
  @concept-theme: App block (Judge.me / Stamped) or section-type="custom-liquid"
{% endcomment %}

<section id="reviews"
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding:{{ section.settings.padding_top }}rem 0 {{ section.settings.padding_bottom }}rem;{% if section.settings.color_scheme == 'custom' %}background:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <div class="stellar-container" style="text-align:center;">
    <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:0.5rem;color:var(--stellar-offwhite);">
      {{ section.settings.heading }}
    </h2>
    <div style="display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-bottom:3rem;">
      {% for i in (1..5) %}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--stellar-skyblue)" stroke="var(--stellar-skyblue)" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      {% endfor %}
      <span class="stellar-font-body" style="color:hsla(0,0%,100%,0.5);font-size:0.875rem;">{{ section.settings.average_text }}</span>
    </div>

    <p class="stellar-font-body" style="color:hsla(0,0%,100%,0.4);font-size:0.875rem;margin-bottom:2rem;font-style:italic;">
      In production, replace with your reviews app block (Judge.me, Stamped, or Okendo).
    </p>

    <div style="display:grid;gap:1.5rem;max-width:64rem;margin:0 auto;" class="stellar-reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div {{ block.shopify_attributes }} class="stellar-hover-lift" style="background:hsla(0,0%,100%,0.05);border-radius:1rem;padding:1.5rem;border:1px solid hsla(0,0%,100%,0.05);text-align:left;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
              <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsla(246,40%,57%,0.3);display:flex;align-items:center;justify-content:center;">
                <span class="stellar-font-display" style="color:var(--stellar-offwhite);font-size:0.75rem;">{{ block.settings.initials }}</span>
              </div>
              <div>
                <span class="stellar-font-body" style="font-size:0.875rem;font-weight:500;color:var(--stellar-offwhite);">{{ block.settings.name }}</span>
                <p class="stellar-font-body" style="font-size:0.75rem;color:hsla(0,0%,100%,0.3);">{{ block.settings.city }}</p>
              </div>
            </div>
            <p class="stellar-font-body" style="color:hsla(0,0%,100%,0.7);font-size:0.875rem;line-height:1.75;">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div style="max-width:48rem;margin:2rem auto 0;">
      {% for block in section.blocks %}
        {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
          {% render 'stellar-standard-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <style>
    @media (min-width: 768px) {
      .stellar-reviews-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Stellar Product Reviews",
  "tag": "section",
  "class": "stellar-product-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "2,027 Five-Star Reviews" },
    { "type": "text", "id": "average_text", "label": "Average text", "default": "4.9 average" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "deepspace" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#22162B" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#F6F7F8" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [{ "type": "text", "id": "name", "label": "Name", "default": "Sarah K." },{ "type": "text", "id": "initials", "label": "Initials", "default": "SK" },{ "type": "text", "id": "city", "label": "City", "default": "Brooklyn, NY" },{ "type": "textarea", "id": "text", "label": "Review text" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Heading" },{ "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h2", "label": "Large" },{ "value": "h3", "label": "Medium" },{ "value": "h4", "label": "Small" }], "default": "h3" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Content", "default": "<p>Body text</p>" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Label", "default": "Learn More" },{ "type": "url", "id": "url", "label": "Link" },{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" },{ "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" },{ "type": "text", "id": "alt", "label": "Alt text", "default": "Image" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    { "name": "Stellar Product Reviews" }
  ]
}
{% endschema %}