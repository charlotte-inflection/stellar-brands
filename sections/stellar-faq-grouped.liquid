{% comment %}
  Stellar FAQ Grouped
  Grouped accordion FAQ with jump links.
  @concept-theme: section-type="collapsible-content"
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding:{{ section.settings.padding_top }}rem 0 {{ section.settings.padding_bottom }}rem;{% if section.settings.color_scheme == 'custom' %}background:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  {%- comment -%} Jump links bar {%- endcomment -%}
  <div style="position:sticky;top:5rem;z-index:20;border-bottom:1px solid hsla(0,0%,13%,0.05);{% if section.settings.color_scheme == 'light' %}background:var(--stellar-offwhite);{% elsif section.settings.color_scheme == 'sand' %}background:var(--stellar-sand);{% else %}background:inherit;{% endif %}">
    <div class="stellar-container" style="max-width:48rem;margin:0 auto;">
      <div class="stellar-scrollbar-hide" style="display:flex;gap:0.5rem;padding:0.75rem 0;overflow-x:auto;">
        {% for block in section.blocks %}
          {% if block.type == 'group' %}
            <a href="#stellar-faq-{{ block.id }}"
              class="stellar-font-body"
              style="padding:0.375rem 1rem;border-radius:9999px;font-size:0.875rem;font-weight:500;white-space:nowrap;background:hsla(0,0%,13%,0.05);opacity:0.5;text-decoration:none;">
              {{ block.settings.group_title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="stellar-container" style="max-width:48rem;margin:0 auto;padding-top:1rem;">
    {% for block in section.blocks %}
      {% if block.type == 'group' %}
        <div id="stellar-faq-{{ block.id }}" style="margin-bottom:2.5rem;scroll-margin-top:8rem;" {{ block.shopify_attributes }}>
          <h2 class="stellar-font-display" style="font-size:1.25rem;margin-bottom:1rem;">{{ block.settings.group_title }}</h2>
          <div class="stellar-faq-items">{{ block.settings.items_html }}</div>
        </div>
      {% elsif block.type == 'item' %}
        <details style="border-bottom:1px solid hsla(0,0%,13%,0.1);" {{ block.shopify_attributes }}>
          <summary class="stellar-font-body" style="padding:1rem 0;font-size:0.875rem;font-weight:500;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;">
            {{ block.settings.question }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="stellar-font-body" style="padding:0 0 1rem;font-size:0.875rem;opacity:0.6;line-height:1.6;">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endif %}
    {% endfor %}

    <div style="max-width:48rem;margin:2rem auto 0;">
      {% for block in section.blocks %}
        {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
          {% render 'stellar-standard-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .stellar-faq-grouped details[open] summary svg { transform: rotate(180deg); }
  .stellar-faq-grouped details summary::-webkit-details-marker { display: none; }
</style>

{% schema %}
{
  "name": "Stellar FAQ Grouped",
  "tag": "section",
  "class": "stellar-faq-grouped",
  "settings": [
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 12, "step": 1, "default": 3, "unit": "rem" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 12, "step": 1, "default": 5, "unit": "rem" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" },{ "value": "deepspace", "label": "Deep Space" },{ "value": "light", "label": "Light" },{ "value": "sand", "label": "Sand" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "custom", "label": "Custom" }], "default": "light" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#F6F7F8" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text", "default": "#222222" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    { "type": "group", "name": "Group Header", "settings": [{ "type": "text", "id": "group_title", "label": "Group title", "default": "Product Questions" },{ "type": "html", "id": "items_html", "label": "Custom HTML (optional)" }] },
    { "type": "item", "name": "FAQ Item", "settings": [{ "type": "text", "id": "question", "label": "Question", "default": "How does Milky work?" },{ "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Milky delivers concentrated lactase enzyme that breaks down lactose before it causes symptoms.</p>" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Heading" },{ "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h2", "label": "Large" },{ "value": "h3", "label": "Medium" },{ "value": "h4", "label": "Small" }], "default": "h3" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Content", "default": "<p>Body text</p>" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Label", "default": "Learn More" },{ "type": "url", "id": "url", "label": "Link" },{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" },{ "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" },{ "type": "text", "id": "alt", "label": "Alt text", "default": "Image" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "Stellar FAQ Grouped",
      "blocks": [
        { "type": "group", "settings": { "group_title": "Product Questions" } },
        { "type": "item", "settings": { "question": "How does Milky work?", "answer": "<p>Milky delivers concentrated lactase enzyme that breaks down lactose — the sugar in dairy — before it reaches your lower intestine. Just take one tablet with your first bite of dairy.</p>" } },
        { "type": "item", "settings": { "question": "What's the difference between Original and Ultra?", "answer": "<p>Original has 10,800 FCC per tablet — great for moderate dairy. Ultra has 21,000 FCC — designed for heavy dairy meals like pizza or ice cream binges.</p>" } }
      ]
    }
  ]
}
{% endschema %}
