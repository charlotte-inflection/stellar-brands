{% comment %}
  Stellar How It Works (About page)
  Two-column image + text explaining the brand science.
  @concept-theme: section-type="image-with-text"
{% endcomment %}

<section
  class="{% if section.settings.color_scheme == 'dark' %}stellar-bg-dark{% elsif section.settings.color_scheme == 'deepspace' %}stellar-bg-deepspace{% elsif section.settings.color_scheme == 'light' %}stellar-bg-light{% elsif section.settings.color_scheme == 'sand' %}stellar-bg-sand{% elsif section.settings.color_scheme == 'skyblue' %}stellar-bg-skyblue{% endif %}{% if section.settings.bg_texture == 'stars' %} stellar-stars-bg{% elsif section.settings.bg_texture == 'constellation' %} stellar-constellation-bg{% elsif section.settings.bg_texture == 'nebula' %} stellar-nebula-gradient{% endif %}{% if section.settings.reveal_animation == 'fade_up' %} stellar-reveal{% elsif section.settings.reveal_animation == 'stagger' %} stellar-reveal-stagger{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.color_scheme == 'custom' %}background-color:{{ section.settings.custom_bg_color }};color:{{ section.settings.custom_text_color }};{% endif %}"
>
  <div class="stellar-container">
    <div style="display:grid;gap:3rem;max-width:64rem;margin:0 auto;align-items:center;" class="stellar-how-it-works-grid">
      <!-- Images -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        {% if section.settings.image_1 != blank %}
          <div style="aspect-ratio:3/4;border-radius:1rem;overflow:hidden;">
            <img src="{{ section.settings.image_1 | image_url: width: 400 }}" alt="Product detail" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
          </div>
        {% else %}
          <div style="aspect-ratio:3/4;border-radius:1rem;background:linear-gradient(135deg, hsla(246,40%,57%,0.1), hsla(211,60%,79%,0.1));border:1px solid hsla(0,0%,13%,0.05);"></div>
        {% endif %}
        {% if section.settings.image_2 != blank %}
          <div style="aspect-ratio:3/4;border-radius:1rem;overflow:hidden;margin-top:2rem;">
            <img src="{{ section.settings.image_2 | image_url: width: 400 }}" alt="Lifestyle" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
          </div>
        {% else %}
          <div style="aspect-ratio:3/4;border-radius:1rem;background:linear-gradient(135deg, hsla(100,55%,55%,0.1), hsla(211,60%,79%,0.1));border:1px solid hsla(0,0%,13%,0.05);margin-top:2rem;"></div>
        {% endif %}
      </div>
      <!-- Text -->
      <div>
        <h2 class="stellar-font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--stellar-black);margin-bottom:1.5rem;line-height:1.2;">
          {{ section.settings.heading }}
        </h2>
        <div class="stellar-font-body" style="color:hsla(0,0%,13%,0.6);line-height:1.75;margin-bottom:2rem;">
          {{ section.settings.body }}
        </div>
        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_url }}" class="stellar-font-body" style="display:inline-block;padding:0.625rem 1.5rem;border-radius:0.5rem;border:1px solid var(--stellar-black);color:var(--stellar-black);text-decoration:none;font-size:0.875rem;">
            {{ section.settings.cta_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div style="max-width:48rem;margin:2rem auto 0;">
      {% for block in section.blocks %}
        {% if block.type == 'heading' or block.type == 'text' or block.type == 'button' or block.type == 'image' or block.type == 'badge' or block.type == 'divider' %}
          {% render 'stellar-standard-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <style>
    @media (min-width: 768px) {
      .stellar-how-it-works-grid { grid-template-columns: 1fr 1fr !important; }
    }
  </style>
</section>

{% schema %}
{
  "name": "Stellar How It Works",
  "tag": "section",
  "class": "stellar-how-it-works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your body stopped making enough lactase. We put it in a credit card." },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Lactase is the enzyme your body uses to break down lactose. Most people produce less of it after childhood. Milky delivers a concentrated dose in a wallet-sized card.</p>" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Learn the Science →" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (product)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (lifestyle)" },
    { "type": "header", "content": "Layout & Style" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80, "unit": "px" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "dark", "label": "Dark" }, { "value": "deepspace", "label": "Deep Space" }, { "value": "light", "label": "Light" }, { "value": "sand", "label": "Sand" }, { "value": "skyblue", "label": "Sky Blue" }, { "value": "custom", "label": "Custom" }], "default": "light" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_bg_color", "label": "Custom background", "default": "#F6F7F8" },
    { "visible_if": "{{ section.settings.color_scheme == 'custom' }}", "type": "color", "id": "custom_text_color", "label": "Custom text color", "default": "#222222" },
    { "type": "select", "id": "bg_texture", "label": "Background texture", "options": [{ "value": "none", "label": "None" },{ "value": "stars", "label": "Stars" },{ "value": "constellation", "label": "Constellation" },{ "value": "nebula", "label": "Nebula" }], "default": "none" },
    { "type": "select", "id": "reveal_animation", "label": "Scroll animation", "options": [{ "value": "none", "label": "None" },{ "value": "fade_up", "label": "Fade up" },{ "value": "stagger", "label": "Stagger children" }], "default": "none" }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Heading text", "default": "Heading" }, { "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h1", "label": "Extra Large" }, { "value": "h2", "label": "Large" }, { "value": "h3", "label": "Medium" }], "default": "h2" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "content", "label": "Text" }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "text", "label": "Button text", "default": "Learn More" }, { "type": "url", "id": "url", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "outline", "label": "Outline" }], "default": "primary" }] },
    { "type": "image", "name": "Image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "alt", "label": "Alt text" }] },
    { "type": "badge", "name": "Badge", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "New" },{ "type": "select", "id": "color", "label": "Color", "options": [{ "value": "green", "label": "Green" },{ "value": "skyblue", "label": "Sky Blue" },{ "value": "purple", "label": "Purple" },{ "value": "gold", "label": "Gold" }], "default": "skyblue" }] },
    { "type": "divider", "name": "Divider", "settings": [{ "type": "select", "id": "style", "label": "Style", "options": [{ "value": "line", "label": "Line" },{ "value": "space", "label": "Space" },{ "value": "dotted", "label": "Dotted" }], "default": "line" },{ "type": "range", "id": "spacing", "label": "Spacing", "min": 1, "max": 6, "step": 1, "default": 2, "unit": "rem" }] }
  ]}
{% endschema %}
