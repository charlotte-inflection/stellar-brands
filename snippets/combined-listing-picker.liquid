{%- doc -%}
  Combined-listing option selectors for the combined PDP templates.

  Rendered by the main-product `combined_picker` block. Renders only the parent/combined options
  (an option is "combined" when any of its values links to another product via value.product_url):
    - Non-swatch options (e.g. Strength) render as text-label buttons.
    - Swatch options (name contains the swatch trigger, e.g. Color) render as image swatches.

  Markup/classes mirror product-variant-picker-swatch.liquid so styling matches the stock picker.
  The in-child option (Size) is rendered by the stock variant picker, not here.

  Selecting a value here is handled by assets/combined-listing-swap.js: it swaps the active child
  in place (no reload), keeping one URL. Swap targets carry data-combined-swap-url.

  Swatch image resolution order:
    1. child product metafield custom.swatch  (value.variant.product.metafields.custom.swatch)
    2. native Shopify swatch                   (value.swatch.image / value.swatch.color)
    3. theme file named <value-handle>.png

  Availability is read from the child product, since option_value.available is unreliable on a
  combined parent (the parent holds no sellable inventory).

  @param {object} product - Current product (combined-listing parent or active child)
  @param {object} section - Host section (for scoping ids)
{%- enddoc -%}

{%- liquid
  assign swatch_triggers = 'products.general.color_swatch_trigger' | t | downcase | split: ','
  assign swatch_triggers = swatch_triggers | join: ',' | append: ',sleeve' | split: ','
-%}

<div class="combined-listing-picker grid gap-5" data-combined-listing>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign is_combined = false
      for value in option.values
        if value.product_url != blank
          assign is_combined = true
          break
        endif
      endfor
      unless is_combined
        continue
      endunless

      assign downcased_option = option.name | downcase
      assign is_swatch_option = false
      for trigger in swatch_triggers
        assign swatch_trigger = trigger | strip
        if swatch_trigger != blank and downcased_option contains swatch_trigger
          assign is_swatch_option = true
          break
        endif
      endfor
    -%}

    <fieldset class="product-form__input variant-input-wrapper relative" data-combined-option="{{ option.name | handle }}">
      <legend class="sr-only">{{ option.name | escape }}</legend>
      {%- if is_swatch_option -%}
        <div class="form__label flex items-center gap-2">
          <span class="variant-label-name">{{- option.name | escape -}}:</span>
          <span class="variant-label-value">{{ option.selected_value | escape }}</span>
        </div>
      {%- endif -%}

      <ul class="swatches swatches--{{ settings.rounded_swatch }} flex items-start flex-wrap gap-4">
        {%- for value in option.values -%}
          {%- liquid
            assign is_current = false
            if value.product_url == blank or value.product_url == product.url
              assign is_current = true
            endif
            assign target_url = value.variant.url | default: value.product_url
            assign input_id = 'CL-' | append: section.id | append: '-' | append: option.name | handle | append: '-' | append: forloop.index0
            assign input_name = 'CL-' | append: section.id | append: '-' | append: option.name | handle

            assign cl_child = value.variant.product
            assign value_available = true
            if cl_child != blank and cl_child.available == false
              assign value_available = false
            endif
          -%}
          <li>
            <magnet-element class="block">
              <input
                type="radio"
                class="sr-only{% unless value_available %} disabled{% endunless %}"
                id="{{ input_id }}"
                name="{{ input_name }}"
                {% if is_current %}checked{% endif %}
                {% unless is_current %}data-combined-swap-url="{{ target_url }}"{% endunless %}
                tabindex="-1"
              />
              {%- if is_swatch_option -%}
                {%- liquid
                  assign swatch_image = blank
                  assign swatch_fallback = value | handle

                  if cl_child != blank and cl_child.metafields.custom.swatch.value != blank
                    assign mf_swatch = cl_child.metafields.custom.swatch.value
                    if mf_swatch.image
                      assign swatch_image = mf_swatch | image_url: width: 128
                    elsif mf_swatch contains 'shopify.com'
                      assign swatch_image = mf_swatch
                    endif
                  endif

                  if swatch_image == blank and value.swatch.image
                    assign swatch_image = value.swatch.image | image_url: width: 128
                  elsif swatch_image == blank and value.swatch.color
                    assign swatch_fallback = value.swatch.color
                  endif

                  if swatch_image == blank and value.swatch == blank
                    assign file_name = value | handle | append: '.png'
                    if images[file_name] != blank
                      assign swatch_image = images[file_name] | image_url: width: 128
                    endif
                  endif
                -%}
                <label
                  for="{{ input_id }}"
                  class="color-swatch{% if swatch_image != blank %} with-image{% endif %} cursor-pointer block relative"
                  title="{{ value | escape }}"
                  {% unless is_current %}data-combined-swap-url="{{ target_url }}"{% endunless %}
                  style="--swatch-background: {{ swatch_fallback }};{% if swatch_image != blank %}--swatch-background-image: url({{ swatch_image }});{% endif %}"
                >
                  <span class="sr-only">{{ value | escape }}</span>
                  <span class="tooltip opacity-0 pointer-events-none text-xs rounded-full z-10">{{ value | escape }}</span>
                </label>
              {%- else -%}
                <label
                  for="{{ input_id }}"
                  class="label-swatch text-sm font-medium leading-none cursor-pointer block relative"
                  title="{{ value | escape }}"
                  {% unless is_current %}data-combined-swap-url="{{ target_url }}"{% endunless %}
                >
                  {{- value | escape -}}
                </label>
              {%- endif -%}
            </magnet-element>
          </li>
        {%- endfor -%}
      </ul>
    </fieldset>
  {%- endfor -%}
</div>

<script src="{{ 'combined-listing-swap.js' | asset_url }}" defer></script>
