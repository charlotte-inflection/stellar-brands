{%- doc -%}
  Renders variant picker as color swatches.
  Swatch images: checks variant metafield custom.swatch first, then falls back
  to Shopify native swatch system, then file-based/config-based lookups.

  @param {object} product - Shopify product object with variants and option data
  @param {string} product_id - Unique product identifier for element targeting
  @param {string} section_id - Section identifier for form namespacing
  @param {boolean} [enable_dynamic_variants] - Enable dynamic product options
  @param {string} [label_display] - Label display mode: label_value, label_only, value_only, hidden
  @param {string} [label_display_option_1] - Per-option override for option 1
  @param {string} [label_display_option_2] - Per-option override for option 2
  @param {string} [label_display_option_3] - Per-option override for option 3
  @param {object} [size_chart] - Shopify page object for size chart
  @param {string} [context] - Context identifier for ID generation
  @param {string} [shopify_attributes] - Shopify-specific attributes

  @example
  {% render 'product-variant-picker-swatch',
    product: product,
    product_id: product.id,
    section_id: section.id
  %}
{%- enddoc -%}

<variant-picker id="VariantPicker-{{ section_id }}-{{ product_id }}{% if context == 'bundle' %}-swatch{% endif %}" class="variant-picker grid gap-5{% if context == 'bundle' %} overflow-hidden{% endif %} no-js-hidden"{% if enable_dynamic_variants %} data-dynamic-variants{% endif %} {{ shopify_attributes }}>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign is_color = false
      assign swatch_trigger_list = 'products.general.color_swatch_trigger' | t | downcase | split: ','
      assign downcased_option = option.name | downcase
      for trigger in swatch_trigger_list
        assign swatch_trigger = trigger | strip
        if downcased_option contains swatch_trigger
          assign is_color = true
        elsif swatch_trigger == 'color' and downcased_option contains 'colour'
          assign is_color = true
        endif

        if is_color == true
          break
        endif
      endfor

      assign is_size = false
      if size_chart != blank
        assign size_trigger = 'products.general.size_trigger' | t | downcase
        assign downcased_option = option.name | downcase
        if downcased_option contains size_trigger
          assign is_size = true
        endif
      endif

      assign option_index_0 = forloop.index0
    -%}
    {%- liquid
      assign effective_label_display = label_display
      case forloop.index
        when 1
          if label_display_option_1 != blank and label_display_option_1 != 'inherit'
            assign effective_label_display = label_display_option_1
          endif
        when 2
          if label_display_option_2 != blank and label_display_option_2 != 'inherit'
            assign effective_label_display = label_display_option_2
          endif
        when 3
          if label_display_option_3 != blank and label_display_option_3 != 'inherit'
            assign effective_label_display = label_display_option_3
          endif
      endcase
    -%}
    <fieldset class="js product-form__input variant-input-wrapper relative"
      data-option-index="option{{ forloop.index }}"
      data-option-slug="{{ option.name | handleize }}"
    >
      <legend class="sr-only">{{ option.name }}</legend>
      <div class="form__label flex items-center justify-between gap-2 w-full">
        {%- if effective_label_display != 'hidden' -%}
          <div class="flex gap-2">
            {%- if effective_label_display == 'label_value' or effective_label_display == blank -%}
              <span class="variant-label-name">{{- option.name -}}:</span>
              <span class="variant-label-value" id="{{ section_id }}-{{ product_id }}-option{{ option.position }}">{{ option.selected_value }}</span>
            {%- elsif effective_label_display == 'label_only' -%}
              <span class="variant-label-name">{{- option.name -}}</span>
            {%- elsif effective_label_display == 'value_only' -%}
              <span class="variant-label-value" id="{{ section_id }}-{{ product_id }}-option{{ option.position }}">{{ option.selected_value }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if is_size -%}
          <div class="flex items-center gap-2">
            {%- render 'icon', icon: 'ruler', size: 'xs', class: 'stroke-1' -%}
            <button type="button" class="link text-sm leading-tight cursor-pointer" aria-controls="SizeChart-{{ section_id }}-{{ product_id }}" aria-expanded="false">
              {{- 'products.general.size_chart' | t -}}
            </button>
            <x-modal id="SizeChart-{{ section_id }}-{{ product_id }}" class="x-modal drawer z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none"
              role="dialog"
              aria-modal="true"
              aria-label="{{ size_chart.title | escape }}"
              hidden
            >
              <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="SizeChart-{{ section_id }}-{{ product_id }}" aria-expanded="false"></overlay-element>
              <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
                <gesture-element class="drawer__header flex justify-between opacity-0 invisible relative" tabindex="0">
                  <span class="drawer__title heading title-md">{{ size_chart.title | escape }}</span>
                  <button class="button button--secondary button--close drawer__close hidden sm:flex items-center justify-center" type="button" is="hover-button" aria-controls="SizeChart-{{ section_id }}-{{ product_id }}" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- render 'icon', icon: 'close', size: 'sm' -%}
                    </span>
                  </button>
                </gesture-element>
                <div class="drawer__content opacity-0 invisible flex flex-col h-full grow shrink">
                  <div class="drawer__scrollable relative flex flex-col gap-5 md:gap-7 grow shrink">
                    <div class="rte text-base md:text-lg">{{ size_chart.content }}</div>
                  </div>
                </div>
              </div>
            </x-modal>
          </div>
        {%- endif -%}
      </div>
      {%- capture swatchs_content -%}
        {%- for value in option.values -%}
          {%- if is_color and value.available == false -%}{%- continue -%}{%- endif -%}
          <li>
            <magnet-element class="block">
              <input
                type="radio"
                class="sr-only{% unless value.available %} disabled{% endunless %}"
                id="{{ section_id }}-{{ product_id }}-{{ option.name | handle }}-{{ forloop.index0 }}"
                name="{{ option.name }}-{{ section_id }}-{{ product_id }}"
                value="{{ value | escape }}"
                {% if option.selected_value == value %}checked{% endif %}
                {% if value.product_url != blank and value.product_url != product.url %}data-product-url="{{ value.variant.url | default: value.product_url }}"{% endif %}
                data-option-value="{{ value | escape }}"
                data-option-value-id="{{ value.id }}"
                data-option-index="{{ option.position }}"
                align-selected=".scroll-area"
              />
              {%- if is_color or value.swatch != blank -%}
                {%- liquid
                  comment
                    Swatch image resolution order:
                    1. Variant metafield custom.swatch (image)
                    2. Shopify native value.swatch
                    3. File-based lookup / swatch_config
                  endcomment

                  assign metafield_swatch_image = blank
                  comment
                    Swatch = the PRODUCT metafield custom.swatch of the product that owns the matched
                    variant. On a Combined Listing parent the matched variant belongs to the child
                    product, so this reads the child's product metafield. all_products(handle) is a
                    fallback for contexts where the variant isn't present.
                  endcomment
                  for variant in product.variants
                    assign variant_value = variant.options[option_index_0]
                    if variant_value == value
                      if variant.metafields.custom.swatch.value != blank
                        assign mf_swatch = variant.metafields.custom.swatch.value
                        if mf_swatch.image
                          assign metafield_swatch_image = mf_swatch | image_url: width: 128
                        elsif mf_swatch contains 'shopify.com'
                          assign metafield_swatch_image = mf_swatch
                        endif
                      endif
                      break
                    endif
                  endfor

                  if metafield_swatch_image == blank and value.product_url != blank
                    assign cl_handle = value.product_url | split: '?' | first | split: '/' | last
                    assign cl_product = all_products[cl_handle]
                    if cl_product != blank and cl_product.metafields.custom.swatch.value != blank
                      assign cl_swatch = cl_product.metafields.custom.swatch.value
                      if cl_swatch.image
                        assign metafield_swatch_image = cl_swatch | image_url: width: 128
                      elsif cl_swatch contains 'shopify.com'
                        assign metafield_swatch_image = cl_swatch
                      endif
                    endif
                  endif

                  comment
                    Child-page fallback (SAFE): if nothing above resolved (other sleeves on a child
                    page), look the swatch up in the shared "Color" metaobject by sleeve name, line-
                    aware for Halloween. Tries hyphen and underscore keys, direct value and .value.
                  endcomment
                  if metafield_swatch_image == blank
                    assign cl_val_dc = value | downcase
                    assign cl_key_h = value | handle
                    if cl_val_dc contains 'halloween'
                      if product.handle contains 'nova'
                        assign cl_key_h = 'halloween-limited-edition-nova'
                      else
                        assign cl_key_h = 'halloween-limited-edition-milky'
                      endif
                    endif
                    assign cl_key_u = cl_key_h | replace: '-', '_'
                    for cl_entry in shop.metaobjects.color.values
                      assign cl_field = cl_entry[cl_key_h]
                      unless cl_field
                        assign cl_field = cl_entry[cl_key_u]
                      endunless
                      if cl_field
                        assign cl_file = cl_field.value | default: cl_field
                        assign cl_url = cl_file | image_url: width: 128
                        if cl_url != blank
                          assign metafield_swatch_image = cl_url
                        endif
                        break
                      endif
                    endfor
                  endif

                  if metafield_swatch_image != blank
                    assign swatch_image = metafield_swatch_image
                    assign swatch_fallback = value | split: ' ' | last | handle
                    assign swatch_fallback_override = false
                  elsif value.swatch == blank
                    assign file_extension = 'png'
                    assign file_name = value | handle | append: '.' | append: file_extension
                    assign swatch_fallback = value | split: ' ' | last | handle
                    assign swatch_fallback_override = false

                    if settings.swatch_config != blank
                      assign value_downcase = value | downcase
                      assign swatch_config = settings.swatch_config | newline_to_br | split: '<br />'
                      for swatch in swatch_config
                        assign swatch_parts = swatch | strip | split: ':'
                        assign swatch_name = swatch_parts.first | downcase | strip

                        if swatch_name == value_downcase
                          assign swatch_value = swatch_parts.last | strip
                          if swatch_value contains '#'
                            assign swatch_fallback = swatch_value
                            assign swatch_fallback_override = true
                          else
                            assign file_name = swatch_value
                          endif
                          break
                        endif
                      endfor
                    endif

                    assign swatch_image = blank
                    if images[file_name] != blank
                      assign swatch_image = images[file_name] | image_url: width: 128
                    elsif file_name contains '//cdn.shopify.com/'
                      assign swatch_image = file_name
                    endif
                  else
                    assign swatch_image = blank
                    assign swatch_fallback = value | split: ' ' | last | handle
                    if value.swatch.image
                      assign swatch_image = value.swatch.image | image_url: width: 128
                      assign swatch_fallback_override = false
                    elsif value.swatch.color
                      assign swatch_fallback = value.swatch.color
                    endif
                  endif
                -%}
                <label
                  for="{{ section_id }}-{{ product_id }}-{{ option.name | handle }}-{{ forloop.index0 }}"
                  class="color-swatch{% if swatch_image != blank %} with-image{% endif %} cursor-pointer block relative"
                  title="{{ value | escape }}"
                  style="--swatch-background: {{ swatch_fallback }};{% if swatch_fallback_override == false and swatch_image != blank %}--swatch-background-image: url({{ swatch_image }});{% endif %}"
                >
                  <span class="sr-only">{{ value | escape }}</span>
                  {%- unless context == 'bundle' -%}
                    <span class="tooltip opacity-0 pointer-events-none text-xs rounded-full z-10">{{ value | escape }}</span>
                  {%- endunless -%}
                </label>
              {%- else -%}
                <label
                  for="{{ section_id }}-{{ product_id }}-{{ option.name | handle }}-{{ forloop.index0 }}"
                  class="label-swatch text-sm font-medium leading-none cursor-pointer block relative"
                  title="{{ value | escape }}"
                >
                  {{- value -}}
                </label>
              {%- endif -%}
            </magnet-element>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if context == 'bundle' -%}
        <scroll-shadow class="product-card__bottom grid overflow-hidden">
          <ul class="scroll-area swatches swatches--{{ settings.rounded_swatch }} grid justify-start gap-4">
            {{- swatchs_content -}}
          </ul>
          <template>
            <slot></slot>
            <s dir="{% render 'direction' %}" style="--t: 0;--b: 0;--l: 0;--r: 0;">
              <span class="l"></span>
              <span class="r"></span>
            </s>
            <style>
              :host{display:inline-block;position:relative}:host([hidden]){display:none}
              s{position:absolute;inset:0;pointer-events:none;{% if settings.card_style == 'card' %}--color-background:var(--color-placeholder){% endif %}}
              s span{position:absolute;inset-block:0;width:var(--sp-12);opacity:0;transition:opacity var(--animation-short);}
              s .l{inset-inline-start:0;opacity:var(--l);background:linear-gradient(90deg,rgb(var(--color-background)) 0%,transparent 100%);}
              s .r{inset-inline-end:0;opacity:var(--r);background:linear-gradient(270deg,rgb(var(--color-background)) 0%,transparent 100%);}
              s[dir=rtl] :is(.icon-chevron-left,.icon-chevron-right){transform:scaleX(-1);}
            </style>
          </template>
        </scroll-shadow>
      {%- else -%}
        <ul class="swatches swatches--{{ settings.rounded_swatch }} flex items-start flex-wrap gap-4">
          {{- swatchs_content -}}
        </ul>
      {%- endif -%}
    </fieldset>
  {%- endfor -%}

  <script type="application/json" data-selected-variant>{{ product.selected_or_first_available_variant | json }}</script>
  {%- if product.variants_count <= 250 -%}
    <script type="application/json" data-variants>{{ product.variants | json }}</script>
  {%- endif -%}
</variant-picker>

{%- comment -%} Combined Listings: a combining-option (sleeve/strength) click navigates to the child.
  Concept repaints the buy box as "sold out" for an instant before navigating, which flashes OOS.
  On combined-listing pages only, intercept that change in the capture phase and navigate straight to
  the child so that repaint never happens. Size (no data-product-url) is left untouched. {%- endcomment -%}
{%- assign cl_has_links = false -%}
{%- for cl_o in product.options_with_values -%}
  {%- for cl_v in cl_o.values -%}
    {%- if cl_v.product_url != blank -%}{%- assign cl_has_links = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if cl_has_links -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{%- if cl_has_links -%}
  <script>
    (function () {
      if (window.__clNavNoFlash) return;
      window.__clNavNoFlash = true;
      document.addEventListener('change', function (e) {
        var el = e.target;
        if (!el || el.nodeType !== 1 || !el.getAttribute) return;
        var url = el.getAttribute('data-product-url');
        if (!url && el.tagName === 'SELECT' && el.selectedOptions && el.selectedOptions[0]) {
          url = el.selectedOptions[0].getAttribute('data-product-url');
        }
        if (!url) return; // size / in-child options: let Concept resolve them in place
        // A combined option changed -> stop Concept's OOS repaint and go straight to the child.
        e.stopImmediatePropagation();
        var info = el.closest ? el.closest('product-info') : null;
        if (info) { info.style.opacity = '0.6'; info.style.cursor = 'progress'; }
        window.location.href = url;
      }, true);
    })();
  </script>
{%- endif -%}
