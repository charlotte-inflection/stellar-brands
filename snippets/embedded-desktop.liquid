<div id="frontrow-badge-desktop">
  {% if request.path contains '/products/milky-original' %}
    <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=quant&product_id=5530"></script>
    <iframe class="iframe-frontrow" id="iframe-frontrow-quant-desktop" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=quant&product_id=5530"></iframe>

  {% elsif request.path contains '/products/milky-ultra' %}
    <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=quant&product_id=5531"></script>
    <iframe class="iframe-frontrow" id="iframe-frontrow-quant-desktop" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=quant&product_id=5531"></iframe>

  {% elsif request.path contains '/products/nova' %}
    <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=quant&product_id=6168"></script>
    <iframe class="iframe-frontrow" id="iframe-frontrow-quant-desktop" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=quant&product_id=6168"></iframe>

  {% elsif request.path contains '/products/milky-card' %}
    <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=quant&product_id=5530"></script>
    <iframe class="iframe-frontrow" id="iframe-frontrow-quant-desktop" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=quant&product_id=5530"></iframe>

  {% else %}
    <style>#frontrow-badge-desktop { display: none !important; }</style>
  {% endif %}
</div>

<style>
  #iframe-frontrow-quant-desktop { height: 0px; }
  #frontrow-badge-desktop { position: relative; display: flex; }
  #frontrow-badge-desktop .iframe-frontrow { width: 100%; margin: 0; }

  @media only screen and (max-width: 480px) {
    #frontrow-badge-desktop { display: none !important; }
  }
</style>