ellar_trust_signals_xCzGYH":{"type":"stellar-trust-signals","blocks":{"signal_rzzz8R":{"type":"signal","settings":{"title":"3rd Party Tested","description":"ISO 17025 lab verification.","icon_emoji":"🧪"}},"signal_DGykew":{"type":"signal","settings":{"title":"FODMAP-Free","description":"Safe for sensitive digestive systems.","icon_emoji":"🍽"}},"signal_YXCEib":{"type":"signal","settings":{"title":"Vegan","description":"No animal byproducts.","icon_emoji":"🌿"}},"signal_MCWyR9":{"type":"signal","settings":{"title":"Gluten-Free","description":"Certified gluten free.","icon_emoji":"🌾"}}},"block_order":["signal_rzzz8R","signal_DGykew","signal_YXCEib","signal_MCWyR9"],"name":"Stellar Trust Signals","settings":{"padding_top":4,"padding_bottom":4,"color_scheme":"light","custom_bg_color":"#f6f7f8","custom_text_color":"#222222","bg_texture":"none","reveal_animation":"fade_up","title_color":"#222222","icon_card_color":"#d2e2f2","caption_color":"#666666"}},"stellar_product_faq_Ca6FUY":{"type":"stellar-product-faq","blocks":{"faq_eNHnCt":{"type":"faq","settings":{"question":"What is Milky?","answer":"Milky is a lactase enzyme supplement that helps people with lactose intolerance digest and process dairy. \n\nMilky Original contains 10,800 FCC of lactase enzyme per tablet and Milky Ultra contains 21,000 FCC of lactase enzyme per tablet. Each Milky card contains 24 tablets."}},"faq_9YU6fP":{"type":"faq","settings":{"question":"How and when should I take Milky?","answer":"For best results, you should take a Milky tablet with your first bite of dairy or just before.\n\nTake another tablet every 30-45 minutes if you continue eating dairy.You can either chew or swallow Milky tablets. \n\nWe recommend swallowing Milky tablets because we do not use any flavoring or taste additives in order to keep the size as small as possible."}},"faq_YJJmaj":{"type":"faq","settings":{"question":"What is the difference between Milky Original and Milky Ultra?","answer":"Milky Original contains 10,800 FCC of lactase enzyme per tablet and is 2 millimeters thin. Milky Ultra contains 21,000 FCC of lactase enzyme per tablet and is 4 millimeters thin. Both Milky Original and Milky Ultra are packaged in cards that contain 24 tablets per card.\n\nMilky Original is over 3X stronger than Lactaid Original and super thin and portable, at only 2 millimeters thick.\n\nMilky Ultra is 7X stronger than Lactaid Original and is recommended for extra heavy dairy meals or those with severe lactose intolerance."}},"faq_q4qhx6":{"type":"faq","settings":{"question":"Is Milky vegan, gluten-free, dairy-free, and FODMAP-free?","answer":"Yes! Milky is vegan, gluten-free, dairy-free, and FODMAP free. We use a third party ISO  17025 Certified lab to test every batch we make."}}},"block_order":["faq_eNHnCt","faq_9YU6fP","faq_YJJmaj","faq_q4qhx6"],"custom_css":["h2 {color: #ffffff;}"],"name":"Stellar Product FAQ","settings":{"heading":"Frequently Asked Questions","padding_top":4,"padding_bottom":4,"color_scheme":"deepspace","custom_bg_color":"#22162b","custom_text_color":"#ffffff","bg_texture":"constellation","reveal_animation":"fade_up"}},"stellar_text_marquee_V7V6p7":{"type":"stellar-text-marquee","blocks":{"text_item_tcdNBe":{"type":"text_item","settings":{"text":"TRUSTED BY 100,000+ DAIRY LOVERS"}},"text_item_ix6EJT":{"type":"text_item","settings":{"text":"4.9 ★ RATING"}},"text_item_YkizMX":{"type":"text_item","settings":{"text":"60-DAY GUARANTEE"}}},"block_order":["text_item_tcdNBe","text_item_ix6EJT","text_item_YkizMX"],"name":"Stellar Text Marquee","settings":{"direction":"left","speed":5,"spacing":60,"separator":"·","font_size":26,"font_weight":"700","letter_spacing":5,"padding_top":16,"padding_bottom":16,"color_scheme":"custom","custom_bg_color":"#171717","custom_text_color":"#ffffff"}},"1774399249a239a9a8":{"type":"apps","blocks":{"junip_junip_product_review_FdpzDr":{"type":"shopify:\/\/apps\/junip\/blocks\/junip-product-review\/dc14f5a8-ed15-41b1-ad08-cfba23f9789b","settings":{"product"