st-signals","blocks":{"signal_4emqty":{"type":"signal","settings":{"title":"3rd Party Tested","description":"ISO 17025 lab verification.","icon_emoji":"🧪"}},"signal_MrmBdt":{"type":"signal","settings":{"title":"FODMAP-Free","description":"Safe for sensitive digestive systems.","icon_emoji":"🍽"}},"signal_nfrmyi":{"type":"signal","settings":{"title":"Vegan","description":"No animal byproducts.","icon_emoji":"🌿"}},"signal_3EMmKf":{"type":"signal","settings":{"title":"Gluten-Free","description":"Certified gluten free.","icon_emoji":"🌾"}}},"block_order":["signal_4emqty","signal_MrmBdt","signal_nfrmyi","signal_3EMmKf"],"name":"Stellar Trust Signals","settings":{"padding_top":4,"padding_bottom":4,"color_scheme":"custom","custom_bg_color":"#171717","custom_text_color":"#ffffff","bg_texture":"none","reveal_animation":"fade_up","title_color":"#ffffff","icon_card_color":"#d2e2f2","caption_color":"#ffffff"}},"stellar_homepage_reviews_nDD7Rc":{"type":"stellar-homepage-reviews","blocks":{"testimonial_VTrzCG":{"type":"testimonial","settings":{"quote":"Both my husband and I took a milky tablet before a meal at a fancy restaurant, and we survived without any tummy troubles.","name":"Rebeca O","detail":"Verified Buyer","stars":5}},"testimonial_4eQFFL":{"type":"testimonial","settings":{"quote":"It is one of the pills that work great compared to other brands. Brand name Lactaid taste absolutely grosss, the generic taste better but is not as effective. At least this doesn't have a taste. It works great with 2 pills It fits in my purse fine and the Lunar New Years design was extra cute.","name":"Thuy N","detail":"Verified Buyer","stars":5}},"testimonial_yxDmaG":{"type":"testimonial","settings":{"quote":"This product just WORKS! I carry the tablet card with me in my purse wherever I go so I have it on hand.  I don’t hesitate to have an ice cream, yogurt or milkshake with Milky tablets.  I’ve shared this product with my daughter-in-law who is lactose intolerant and she has had great results with Milky too.","name":"Christine O","detail":"Verified Buyer","stars":5}},"testimonial_yzawRf":{"type":"testimonial","settings":{"quote":"This is such a good product! Have been using milky for almost a whole year now and I wouldn’t want to switch to anything else","name":"Emily P","detail":"Verified Buyer","stars":5}},"testimonial_nkbXwh":{"type":"testimonial","settings":{"quote":"Milky Ultra is my go to for eating cheese! If I didn't have Milky I would would have to go without my cheese addiction.  Thank you Milky!","name":"Lorraine T","detail":"Ultra Customer","stars":5}}},"block_order":["testimonial_VTrzCG","testimonial_4eQFFL","testimonial_yxDmaG","testimonial_yzawRf","testimonial_nkbXwh"],"name":"Stellar Homepage Reviews","settings":{"eyebrow":"REAL REVIEWS","heading":"Trusted by 100,000+ Dairy Lovers","padding_top":60,"padding_bottom":60,"color_scheme":"light","custom_bg_color":"#f6f7f8","custom_text_color":"#222222","bg_texture":"none","reveal_animation":"fade_up"}},"stellar_product_faq_dJLgFi":{"type":"stellar-product-faq","blocks":{"text_FPdXgn":{"type":"text","settings":{"content":"","size":"md","color":""}},"faq_WAgprW":{"type":"faq","settings":{"question":"Is lactose intolerance the same thing as a dairy allergy?","answer":"No. Lactose intolerance is about difficulty digesting lactose, a sugar. A dairy (milk) allergy is an immune reaction to proteins in milk, like casein or whey. The symptoms can overlap, but the mechanisms are completely different. If you're unsure which one you're dealing with, talk to your doctor."}},"faq_NRkzib":{"type":"faq","settings":{"question":"Can lactose intolerance show up later in life?","answer":"Yes, and that's actually the most common pattern. Lactase production naturally declines after childhood at a rate that's largely genetic. Many people don't notice symptoms until adulthood, and some people who ate dairy without issues for decades can gradually develop intolerance."}},"faq_LAMQQi":{"type":"faq","settings":{"question":"Does lactose intolerance mean I have to avoid all dairy?","answer":"No. Tolerance varies widely. Hard, aged cheeses (parmesan, cheddar, Swiss) contain very little lactose. Yogurt and kefir are partially pre-digested by bacterial cultures. Butter has minimal lactose. Many people find they can handle dairy foods without issues when paired with a lactase supplement."}},"faq_RfHCX8":{"type":"faq","settings":{"question":"How does Milky work?","answer":"You take a Milky tablet with your first bite of dairy. The tablet delivers a concentrated dose of lactase enzyme to your small intestine, where it helps break down lactose before it can reach the large intestine and cause symptoms. If you continue eating dairy for more than 30-45 minutes, take another tablet."}},"faq_KYzQhD":{"type":"faq","settings":{"question":"What's the difference between Milky Original and Milky Ultra?","answer":"Enzyme strength. Original delivers 10,800 FCC units of lactase per tablet, which covers everyday dairy like a latte, yogurt, or a few slices of cheese. Ultra delivers 21,000 FCC units for heavier meals: pizza, ice cream sundaes, cream-based pastas."}}},"block_order":["text_FPdXgn","faq_WAgprW","faq_NRkzib","faq_LAMQQi","faq_RfHCX8","faq_KYzQhD"],"custom_css":["\/* Stellar Product FAQ — question & answer text to match Stellar Image + Text *\/.stellar-product-faq .stellar-container details summary {font-size: 1rem !important;}",".stellar-product-faq .stellar-container details > div {font-size: 1rem !important; opacity: 0.7 !important;}"],"name":"Stellar Product FAQ","settings":{"heading":"Frequently Asked Questions","padding_top":5,"padding_bottom":5,"color_scheme":"light","custom_bg_color":"#f6f7f8","custom_text_color":"#222222","bg_texture":"none","reveal_animation":"none"}},"stellar_expert_endorsement_z4G9Jy":{"type":"stellar-expert-endorsement","blocks":{"endorsement_tH3ybf":{"type":"endorsement","settings":{"avatar":"shopify:\/\/shop_images\/custom_resized_6835ac35-7270-461d-8638-85b3