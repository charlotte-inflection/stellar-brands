{"sections":{"main-page":{"type":"main-page","disabled":true,"settings":{"heading_size":"title-lg tracking-heading","heading_alignment":"text-left","heading_tag":"h1","text_size":"text-base","padding_top":72,"padding_bottom":120,"divider":false,"narrow":true,"rounded":false}},"stellar_hero_banner_eKLF8b":{"type":"stellar-hero-banner","blocks":{"badge_LFF343":{"type":"badge","settings":{"label":"The Science of Gut Health","color":"skyblue"}},"heading_bY6APR":{"type":"heading","settings":{"text":"What is lactose intolerance?","size":"h1","heading_font":"default","line_break_after":"","highlight_text":"","highlight_weight":"inherit","highlight_color":"#655dc6"}},"text_x9XU3f":{"type":"text","settings":{"content":"<p>The body produces enzymes that break down the lactose found in dairy products. Some of us don't make enough enzymes to digest dairy without discomfort. Milky supplements your bodies natural digestion, so that you can fully digest and enjoy dairy.<\/p>","color":""}},"text_7perFC":{"type":"text","settings":{"content":"","color":""}},"button_UEMrYP":{"type":"button","settings":{"text":"Shop Milky Cards","url":"","style":"primary"}},"button_ikLdGh":{"type":"button","settings":{"text":"Get Personalized Recommendation","url":"","style":"outline"}}},"block_order":["badge_LFF343","heading_bY6APR","text_x9XU3f","text_7perFC","button_UEMrYP","button_ikLdGh"],"name":"Stellar Hero Banner","settings":{"hero_image_alt":"Product image","hero_video":"shopify:\/\/files\/videos\/Dietitian 001_V2.mp4","hero_video_autoplay":false,"image_position":"right","overlay_color":"#22162b","overlay_opacity":60,"section_height":"full","padding_top":80,"padding_bottom":80,"color_scheme":"dark","custom_bg_color":"#222222","custom_text_color":"#f6f7f8","bg_texture":"constellation","reveal_animation":"none"}},"logo_list_RMrj3M":{"type":"logo-list","blocks":{"logo_Yrnd8F":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/79-791089_press-logos-newyorktimes-logo-new-york-times-800x58